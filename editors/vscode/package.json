{
  "name": "cadetta",
  "displayName": "Cadetta",
  "description": "Syntax highlighting, a cadetta language server client and a check task for Cadetta (.cdt) design-parameter files.",
  "version": "0.1.0",
  "publisher": "cadetta",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lognd/cadetta"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cadetta",
        "aliases": [
          "Cadetta",
          "cadetta"
        ],
        "extensions": [
          ".cdt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cadetta",
        "scopeName": "source.cadetta",
        "path": "./syntaxes/cadetta.tmLanguage.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "cadetta",
        "owner": "cadetta",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "source": "cadetta",
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): (error|warning|info)\\[([A-Za-z0-9]+)\\]: (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "taskDefinitions": [
      {
        "type": "cadetta",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "check"
            ],
            "description": "The cadetta command to run."
          }
        }
      }
    ],
    "configuration": {
      "title": "Cadetta",
      "properties": {
        "cadetta.path": {
          "type": "string",
          "default": "cadetta",
          "description": "Path to the cadetta executable (started as `cadetta lsp`)."
        },
        "cadetta.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the cadetta language server for .cdt files. Disable to fall back to the check task only."
        }
      }
    }
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:cadetta"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  }
}
