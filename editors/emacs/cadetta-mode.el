(require 'compile)
(require 'flymake)

(defgroup cadetta nil
  "Cadetta language support."
  :group 'languages)

(defcustom cadetta-executable "cadetta"
  "The cadetta binary used by the flymake backend and `cadetta-check'."
  :type 'string
  :group 'cadetta)

(defconst cadetta--declaration-names '("pub" "priv" "package" "use" "as" "cite" "interface" "ots" "model" "assembly" "process" "table" "enum" "fn" "let" "part" "alt" "fit" "solver" "datum" "place" "rule" "unit" "kind" "key" "cols"))
(defconst cadetta--control-names '("if" "else" "match" "on" "in" "out" "deps" "require" "check" "for" "satisfies" "waive" "because" "expires" "was" "super"))
(defconst cadetta--operator-names '("and" "or" "not"))
(defconst cadetta--constant-names '("true" "false"))
(defconst cadetta--special-names '("self" "origin"))
(defconst cadetta--type-names '("Bool" "Text" "Count" "Ratio" "Point2" "Point3" "Vec2" "Vec3" "Datum" "Table"))
(defconst cadetta--kind-names '("Length" "Angle" "Area" "Volume" "Mass" "Force" "Torque" "Energy" "Power" "Pressure" "Time" "Money" "Frequency" "Velocity" "VolumeFlow" "Acceleration" "AngularVelocity" "Lead" "Current" "Voltage" "Resistance" "Inertia" "Density" "Temperature" "TemperatureDelta"))
(defconst cadetta--function-names '("min" "max" "abs" "sqrt" "cbrt" "sin" "cos" "tan" "atan2" "round_to" "ceil_to" "floor_to" "floor" "ceil" "round" "count" "sum" "mass" "fmt" "rect_pattern" "circle_pattern" "distance" "radial" "coaxial" "parallel" "angle_between" "aligned"))
(defconst cadetta--pseudo-citations '("measured" "assumed" "estimate"))

(defvar cadetta-mode-syntax-table
  (let ((st (make-syntax-table)))
    (modify-syntax-entry ?/ ". 12b" st)
    (modify-syntax-entry ?\n "> b" st)
    (modify-syntax-entry ?\" "\"" st)
    (modify-syntax-entry ?\\ "\\" st)
    (modify-syntax-entry ?' "." st)
    (modify-syntax-entry ?_ "_" st)
    st)
  "Syntax table for `cadetta-mode'.")

(defvar cadetta-font-lock-keywords
  (list
   ;; contextual words (after `place X', in `[position ...]', cite types, ...)
   '("\\_<place[ \t]+[A-Za-z0-9_:.]+[ \t]+\\(at\\)\\_>" 1 'font-lock-keyword-face)
    '("\\_<\\(script\\)\\_>[ \t]*\"" 1 'font-lock-keyword-face)
    '("\\[[ \t]*\\(position\\)\\_>" 1 'font-lock-keyword-face)
    '("\\_<cite[ \t]+[A-Za-z0-9_]+[ \t]*:[ \t]*\\(datasheet\\|document\\|standard\\|article\\|catalog\\|drawing\\|quote\\|book\\|web\\)\\_>" 1 'font-lock-type-face)
    '("\\_<fit[ \t]+[A-Za-z0-9_]+[ \t]*=[ \t]*\\([A-Za-z]\\{1,2\\}[0-9]\\{1,2\\}\\(/[A-Za-z]\\{1,2\\}[0-9]\\{1,2\\}\\)?\\)\\_>" 1 'font-lock-constant-face)
   (cons (regexp-opt cadetta--declaration-names 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt cadetta--control-names 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt cadetta--operator-names 'symbols) 'font-lock-keyword-face)
   (cons (regexp-opt cadetta--constant-names 'symbols) 'font-lock-constant-face)
   (cons (regexp-opt cadetta--special-names 'symbols) 'font-lock-builtin-face)
   (cons (regexp-opt cadetta--type-names 'symbols) 'font-lock-type-face)
   (cons (regexp-opt cadetta--kind-names 'symbols) 'font-lock-type-face)
   (cons (regexp-opt cadetta--function-names 'symbols) 'font-lock-builtin-face)
   (list (concat "@" (regexp-opt cadetta--pseudo-citations (quote symbols)))
         0 'font-lock-constant-face t)
   '("\\(?:\\_<[0-9]+\\(?:\\.[0-9]+\\)?\\(?:[eE][-+]?[0-9]+\\)?\\(?:-[0-9]+/[0-9]+\\|/[0-9]+\\)?\\(?:[\"']\\|[A-Za-z%][A-Za-z0-9%_]*\\(?:\\^-?[0-9]+\\)?\\(?:[*/][A-Za-z][A-Za-z0-9_]*\\(?:\\^-?[0-9]+\\)?\\)*\\)\\)[ \t]+\\([A-Za-z]\\{1,2\\}[0-9]\\{1,2\\}\\(?:/[A-Za-z]\\{1,2\\}[0-9]\\{1,2\\}\\)?\\_>\\)" 1 'font-lock-constant-face)
    '("\\_<[0-9]+\\(?:\\.[0-9]+\\)?\\(?:[eE][-+]?[0-9]+\\)?\\(?:-[0-9]+/[0-9]+\\|/[0-9]+\\)?\\(?:[\"']\\|[A-Za-z%][A-Za-z0-9%_]*\\(?:\\^-?[0-9]+\\)?\\(?:[*/][A-Za-z][A-Za-z0-9_]*\\(?:\\^-?[0-9]+\\)?\\)*\\)" 0 'font-lock-constant-face)
    '("\\_<[0-9]+\\(?:\\.[0-9]+\\)?\\(?:[eE][-+]?[0-9]+\\)?\\_>" 0 'font-lock-constant-face)
    '("#!?\\[[^]]*\\]" 0 'font-lock-preprocessor-face t)
    '("@\\(?:\"\\(?:\\\\.\\|[^\"\\\\]\\)*\"\\|[A-Za-z_][A-Za-z0-9_]*\\(?:::[A-Za-z_][A-Za-z0-9_]*\\)*\\)\\(?::\"\\(?:\\\\.\\|[^\"\\\\]\\)*\"\\)?" 0 'font-lock-reference-face)
   '("///.*$" 0 font-lock-doc-face t))
  "Font-lock keywords for `cadetta-mode'.")

(defconst cadetta-compilation-regexp
  "^\\([^:\n]+\\):\\([0-9]+\\):\\([0-9]+\\): \\(?:error\\|\\(warning\\)\\|\\(info\\|hint\\)\\)\\["
  "Match `file:line:col: severity[CODE]:' lines of `--format short'.")

(add-to-list 'compilation-error-regexp-alist-alist
             `(cadetta ,cadetta-compilation-regexp 1 2 3 (4 . 5)))
(add-to-list 'compilation-error-regexp-alist 'cadetta)

(defun cadetta-check ()
  "Run `cadetta check --format short' in a compilation buffer."
  (interactive)
  (compile (concat cadetta-executable " check --format short")))

;;;###autoload
(define-derived-mode cadetta-mode prog-mode "Cadetta"
  "Major mode for editing Cadetta (.cdt) source."
  :syntax-table cadetta-mode-syntax-table
  (setq-local comment-start "// ")
  (setq-local comment-end "")
  (setq-local comment-start-skip "//+ *")
  (setq-local font-lock-defaults '(cadetta-font-lock-keywords nil nil))
  (add-hook 'flymake-diagnostic-functions #'cadetta-flymake nil t))

(defvar-local cadetta--flymake-proc nil
  "The running cadetta process of the current buffer, if any.")

(defun cadetta-flymake (report-fn &rest _args)
  "Flymake backend: run `cadetta check --format short' and report via REPORT-FN."
  (unless (executable-find cadetta-executable)
    (error "Cannot find the cadetta executable `%s'" cadetta-executable))
  (when (process-live-p cadetta--flymake-proc)
    (kill-process cadetta--flymake-proc))
  (let ((source (current-buffer))
        (file (and buffer-file-name (file-truename buffer-file-name))))
    (save-restriction
      (widen)
      (setq cadetta--flymake-proc
            (make-process
             :name "cadetta-flymake"
             :noquery t
             :connection-type 'pipe
             :buffer (generate-new-buffer " *cadetta-flymake*")
             :command (list cadetta-executable "check" "--format" "short")
             :sentinel
             (lambda (proc _event)
               (when (memq (process-status proc) '(exit signal))
                 (unwind-protect
                     (when (with-current-buffer source (eq proc cadetta--flymake-proc))
                       (with-current-buffer (process-buffer proc)
                         (goto-char (point-min))
                         (let (diags)
                           (while (search-forward-regexp
                                   "^\\([^:\n]+\\):\\([0-9]+\\):\\([0-9]+\\): \\([a-z]+\\)\\[\\([A-Z0-9]+\\)\\]: \\(.*\\)$"
                                   nil t)
                             (let ((path (match-string 1))
                                   (line (string-to-number (match-string 2)))
                                   (col (string-to-number (match-string 3)))
                                   (sev (match-string 4))
                                   (code (match-string 5))
                                   (msg (match-string 6)))
                               (when (and file
                                          (string= (file-truename (expand-file-name path))
                                                   file))
                                 (let ((region (flymake-diag-region source line col)))
                                   (push (flymake-make-diagnostic
                                          source (car region) (cdr region)
                                          (cond ((string= sev "error") :error)
                                                ((string= sev "warning") :warning)
                                                (t :note))
                                          (format "%s: %s" code msg))
                                         diags)))))
                           (funcall report-fn (nreverse diags)))))
                   (kill-buffer (process-buffer proc))))))))))

;;;###autoload
(add-to-list 'auto-mode-alist '("\\.cdt\\'" . cadetta-mode))

(provide 'cadetta-mode)

