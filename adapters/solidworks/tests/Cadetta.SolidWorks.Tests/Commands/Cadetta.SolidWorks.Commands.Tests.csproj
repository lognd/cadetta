<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the add-in command logic (Core/Commands and AddIn/Commands); sources are linked so no net48 or SOLIDWORKS is needed. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cadetta.SolidWorks.Commands.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\src\Cadetta.SolidWorks.AddIn\Client\*.cs" LinkBase="Client" />
    <Compile Include="..\..\..\src\Cadetta.SolidWorks.AddIn\Commands\*.cs" LinkBase="Commands" />
    <ProjectReference Include="..\..\..\src\Cadetta.SolidWorks.Core\Cadetta.SolidWorks.Core.csproj" />
  </ItemGroup>
</Project>
