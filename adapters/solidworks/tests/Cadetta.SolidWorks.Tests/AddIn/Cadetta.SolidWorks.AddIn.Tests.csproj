<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests for the add-in's interop-free logic (Client, Pane, Logging, AddInSettings); the sources are linked so no net48 or SOLIDWORKS is needed. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>Cadetta.SolidWorks.AddIn.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\..\src\Cadetta.SolidWorks.AddIn\Client\*.cs" LinkBase="Client" />
    <Compile Include="..\..\..\src\Cadetta.SolidWorks.AddIn\Pane\*.cs" LinkBase="Pane" />
    <Compile Include="..\..\..\src\Cadetta.SolidWorks.AddIn\Logging\*.cs" LinkBase="Logging" />
    <Compile Include="..\..\..\src\Cadetta.SolidWorks.AddIn\AddInSettings.cs" LinkBase="." />
    <ProjectReference Include="..\..\..\src\Cadetta.SolidWorks.Core\Cadetta.SolidWorks.Core.csproj" />
  </ItemGroup>
</Project>
