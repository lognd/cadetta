grimble = "2";
part of cadetta;

/// ADR: draft-1 language decisions (interfaces, alternates, obligations core, solvers).
vmodel dec_draft1 {
  kind decision;
  level system_design;
  ref "docs/decisions/2026-10-13-draft-1-language-decisions.md";
  decides req_language;
}

/// ADR: draft-1.1 decisions (let, closure digests, variant evaluation, std fasteners).
vmodel dec_draft1_1 {
  kind decision;
  level system_design;
  ref "docs/decisions/2026-10-13-draft-1-1-decisions.md";
  decides req_stdlib;
}

/// ADR: IR between source and every CAD tool.
vmodel dec_ir {
  kind decision;
  level system_design;
  ref "docs/decisions/2026-10-13-ir-centered-adapters.md";
  decides req_ir;
}

/// ADR: first-class exact kinded quantities.
vmodel dec_quantities {
  kind decision;
  level system_design;
  ref "docs/decisions/2026-10-13-quantities-first-class.md";
  decides req_quantities;
}

/// ADR: Rust core, polyglot adapters.
vmodel dec_rust {
  kind decision;
  level system_design;
  ref "docs/decisions/2026-10-13-rust-implementation.md";
  decides req_adapters;
}

/// The adapter contract and protocol (adapters.md).
vmodel req_adapters {
  kind artifact;
  level requirements;
  ref "docs/spec/adapters.md";
}

/// Configuration and command line (config-cli.md).
vmodel req_cli {
  kind artifact;
  level requirements;
  ref "docs/spec/config-cli.md";
}

/// The tool-agnostic IR, `cadetta.ir/1` (ir.md).
vmodel req_ir {
  kind artifact;
  level requirements;
  ref "docs/spec/ir.md";
}

/// The `.cdt` language and its static semantics (language.md).
vmodel req_language {
  kind artifact;
  level requirements;
  ref "docs/spec/language.md";
}

/// The lint catalog (lints.md).
vmodel req_lints {
  kind artifact;
  level requirements;
  ref "docs/spec/lints.md";
}

/// The obligation graph and lock file (obligations.md). Core.
vmodel req_obligations {
  kind artifact;
  level requirements;
  ref "docs/spec/obligations.md";
}

/// Quantities are exact, kinded and single-token (quantities.md).
vmodel req_quantities {
  kind artifact;
  level requirements;
  ref "docs/spec/quantities.md";
}

/// The external solver protocol `cadetta.solve/1` (solvers.md).
vmodel req_solvers {
  kind artifact;
  level requirements;
  ref "docs/spec/solvers.md";
}

/// The standard library: fits, materials, fasteners, ScrewJoint (stdlib.md).
vmodel req_stdlib {
  kind artifact;
  level requirements;
  ref "docs/spec/stdlib.md";
}
