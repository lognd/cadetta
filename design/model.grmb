grimble = "2";
module cadetta;

include "vmodel.grmb";

/// External FreeCAD adapter process, the reference read/drive adapter.
node adapter_freecad : authenticated {
  kind component;
  clearance Internal;
  owns "adapters/freecad/**";
  may fs.read at "adapters/freecad/**";
  may fs.write at "adapters/freecad/**";
}

/// Adapter host: built-in emitters and the JSON-RPC client for external adapters (adapters.md).
node adapter_host : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-adapter/**";
  may exec at "crates/cadetta-adapter/src/external/**";
  may fs.write at "crates/cadetta-adapter/src/builtin/**";
}

/// External SOLIDWORKS adapter (Python, pywin32 COM), the primary drive target.
node adapter_solidworks : authenticated {
  kind component;
  clearance Internal;
  owns "adapters/solidworks/**";
  may fs.read at "adapters/solidworks/**";
  may fs.write at "adapters/solidworks/**";
}

/// A CAD tool session or native file set, outside our code.
node cad_tool : foreign {
  kind external;
  clearance Internal;
}

/// The `cadetta` binary: config loading and verbs (config-cli.md).
node cli : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-cli/**";
  may fs.read at "crates/cadetta-cli/**";
}

/// ISO 286 fit tables shipped as package data (language.md 3.2).
node fits : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-fits/**";
  may fs.read at "crates/cadetta-fits/**";
}

/// The `cadetta.ir/1` types, JSON schema, canonical paths and digests (ir.md).
node ir : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-ir/**";
}

/// The rule catalog: pure functions from IR to diagnostics (lints.md).
node lint : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-lint/**";
}

/// The one owner of tracing subscriber setup, `CADETTA_LOG` filtering and secret redaction.
node log : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-log/Cargo.toml";
  owns "crates/cadetta-log/src/init.rs";
  owns "crates/cadetta-log/src/lib.rs";
  owns "crates/cadetta-log/src/redact.rs";
  owns "crates/cadetta-log/src/testing.rs";
}

/// The obligation graph, digests, staleness and `cadetta.lock` (obligations.md).
node obligations : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-obligations/**";
  may fs.read at "cadetta.lock";
  may fs.write at "cadetta.lock";
}

/// The Python binding: PyO3 extension and pydantic layer, the importable `cadetta` (bindings.md).
node py_binding : trusted {
  kind component;
  clearance Internal;
  owns "bindings/python/**";
  may exec at "bindings/python/tests/**";
  may fs.read at "bindings/python/python/cadetta/logging/**";
  may fs.read at "bindings/python/tests/**";
}

/// Name resolution, kind checking and evaluation into design IR.
node sema : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-sema/**";
}

/// Runs external solvers over `cadetta.solve/1` and caches results (solvers.md).
node solver_host : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-solve/**";
  may exec at "crates/cadetta-solve/src/**";
}

/// A user's solver script (Python, MATLAB, ...), outside our code; its outputs are untrusted.
node solver_script : foreign {
  kind external;
  clearance Internal;
}

/// Lexer, parser and formatter for `.cdt` source (language.md).
node syntax : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-syntax/**";
}

/// Exact rational quantities, units, kinds and tolerances (quantities.md).
node units : trusted {
  kind component;
  clearance Internal;
  owns "crates/cadetta-units/**";
}

flow f_ast : syntax -> sema {
  producer "crates/cadetta-syntax/src/**";
  consumer "crates/cadetta-sema/src/**";
  label Internal;
  transport in_process;
}

flow f_design_ir : sema -> ir {
  label Internal;
  transport in_process;
}

flow f_diagnostics : lint -> cli {
  label Internal;
  transport in_process;
}

flow f_drive : adapter_freecad -> cad_tool {
  label Internal;
  transport ffi;
}

flow f_drive_sw : adapter_solidworks -> cad_tool {
  label Internal;
  transport ffi;
}

flow f_fit_tables : fits -> sema {
  label Internal;
  transport in_process;
}

flow f_ir_to_adapters : ir -> adapter_host {
  label Internal;
  transport in_process;
}

flow f_ir_to_lint : ir -> lint {
  label Internal;
  transport in_process;
}

flow f_ir_to_obligations : ir -> obligations {
  label Internal;
  transport in_process;
}

flow f_logging : cli -> log {
  label Internal;
  transport in_process;
}

flow f_obligation_state : obligations -> lint {
  label Internal;
  transport in_process;
}

flow f_observed_ir : adapter_host -> lint {
  label Internal;
  transport in_process;
}

flow f_py_cli : cli -> py_binding {
  label Internal;
  transport in_process;
}

flow f_py_ir : ir -> py_binding {
  label Internal;
  transport in_process;
}

flow f_py_quantity_syntax : syntax -> py_binding {
  label Internal;
  transport in_process;
}

flow f_py_quantity_units : units -> py_binding {
  label Internal;
  transport in_process;
}

flow f_quantities : units -> sema {
  label Internal;
  transport in_process;
}

flow f_read : cad_tool -> adapter_freecad {
  label Internal;
  transport file;
}

flow f_read_sw : cad_tool -> adapter_solidworks {
  label Internal;
  transport ipc;
}

flow f_rpc_request : adapter_host -> adapter_freecad {
  label Internal;
  transport ipc;
}

flow f_rpc_request_sw : adapter_host -> adapter_solidworks {
  label Internal;
  transport ipc;
}

flow f_rpc_response : adapter_freecad -> adapter_host {
  label Internal;
  transport ipc;
}

flow f_rpc_response_sw : adapter_solidworks -> adapter_host {
  label Internal;
  transport ipc;
}

flow f_solve_request : solver_host -> solver_script {
  label Internal;
  transport ipc;
}

flow f_solve_response : solver_script -> solver_host {
  label Internal;
  transport ipc;
}

flow f_solver_results : solver_host -> sema {
  label Internal;
  transport file;
}

/// Only adapters touch CAD tools; the kernel never links a vendor SDK.
claim kernel_never_touches_cad {
  noflow sema -> cad_tool;
  proof L1;
}

/// Lints never talk to a CAD tool directly; everything goes through the IR.
claim lint_is_tool_agnostic {
  noflow cad_tool -> lint;
  proof L1;
}

/// Solver scripts never reach a CAD tool; their outputs enter only through checked IR values.
claim solvers_never_touch_cad {
  noflow solver_script -> cad_tool;
  proof L1;
}
