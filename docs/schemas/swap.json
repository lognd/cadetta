{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Swap",
  "description": "A `cadetta.swap/1` report: the preview of `cadetta impact --swap PART NEW`.",
  "type": "object",
  "required": [
    "schema",
    "swap",
    "verdict",
    "values_changed",
    "verdicts_flipped",
    "suggested_edit",
    "cad_resync",
    "attestations_invalidated",
    "commercial_deltas"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "cadetta.swap/1"
    },
    "swap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "alternate",
        "approved"
      ],
      "properties": {
        "slot": {
          "description": "Canonical path of the part slot.",
          "type": "string"
        },
        "alternate": {
          "description": "The replacement component.",
          "type": "string"
        },
        "approved": {
          "description": "True when the replacement is in the slot's alt list.",
          "type": "boolean"
        }
      }
    },
    "verdict": {
      "enum": [
        "ok",
        "ok with warnings",
        "blocked"
      ]
    },
    "values_changed": {
      "description": "Direct values first, then derived, each sorted by path.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "old",
          "new",
          "class"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "old": {
            "description": "Value under the primary, as authored; null when the member had none.",
            "type": [
              "string",
              "null"
            ]
          },
          "new": {
            "type": "string"
          },
          "class": {
            "enum": [
              "direct",
              "derived"
            ]
          }
        }
      }
    },
    "verdicts_flipped": {
      "description": "Checks whose verdict differs under the swap, sorted by path.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "old",
          "new"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "old": {
            "$ref": "#/$defs/Verdict"
          },
          "new": {
            "$ref": "#/$defs/Verdict"
          }
        }
      }
    },
    "suggested_edit": {
      "description": "The new `part` line.",
      "type": "string"
    },
    "cad_resync": {
      "description": "CAD files to re-sync under the swap.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stale",
        "not_stale",
        "replace_component"
      ],
      "properties": {
        "stale": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "paths"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "not_stale": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replace_component": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "attestations_invalidated": {
      "description": "Attestations the swap invalidates.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "covered_nodes_affected"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "covered_nodes_affected": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "commercial_deltas": {
      "description": "Commercial roll-up deltas.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assembly",
        "deltas",
        "moq",
        "missing"
      ],
      "properties": {
        "assembly": {
          "type": "string"
        },
        "deltas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Delta"
          }
        },
        "moq": {
          "oneOf": [
            {
              "$ref": "#/$defs/Delta"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "param",
              "side",
              "parts"
            ],
            "properties": {
              "param": {
                "type": "string"
              },
              "side": {
                "enum": [
                  "before",
                  "after"
                ]
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "Verdict": {
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not evaluated"
      ]
    },
    "Delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "old",
        "new"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "old": {
          "type": [
            "string",
            "null"
          ]
        },
        "new": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
