{
  "$id": "cadetta.obligations/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Output of `cadetta obligations --format json`: open and stale obligations.",
  "properties": {
    "schema": { "const": "cadetta.obligations/1" },
    "as_of": { "description": "Report date, YYYY-MM-DD.", "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "as_of_source": { "enum": ["flag", "config", "today"] },
    "gated": { "description": "True when any listed row is required for the gate.", "type": "boolean" },
    "obligations": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "state": { "enum": ["stale", "open", "discharged", "violated", "undecided", "waived"] },
          "role": { "type": ["string", "null"] },
          "attester": { "type": ["string", "null"] },
          "age_days": { "type": ["integer", "null"] },
          "nearest_changed": { "type": ["string", "null"] },
          "note": { "type": ["string", "null"] },
          "upstream": { "description": "Attestations of this node carried by a dependency lock (attested upstream).", "type": "array", "items": { "type": "string" } }
        },
        "required": ["id", "state", "role", "attester", "age_days", "nearest_changed", "note", "upstream"],
        "type": "object"
      }
    }
  },
  "required": ["schema", "as_of", "as_of_source", "gated", "obligations"],
  "title": "ObligationsOutput",
  "type": "object"
}
