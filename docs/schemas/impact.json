{
  "$defs": {
    "Dependent": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "description": "Reads between this node and PATH, at least 1.",
          "minimum": 1,
          "type": "integer"
        },
        "effect": {
          "enum": [
            "changes",
            "stale",
            "may_flip"
          ]
        },
        "kind": {
          "enum": [
            "member",
            "check",
            "solver"
          ]
        },
        "path": {
          "type": "string"
        },
        "via": {
          "description": "The node it reads that leads back to PATH.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "via",
        "depth",
        "effect"
      ],
      "type": "object"
    },
    "Obligation": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "enum": [
            "stale",
            "may_flip"
          ]
        },
        "id": {
          "description": "Obligation id, `KIND:PATH`.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "effect"
      ],
      "type": "object"
    }
  },
  "$id": "cadetta.impact/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Output of `cadetta impact PATH --format json`: everything downstream of one path.",
  "properties": {
    "dependents": {
      "description": "Downstream nodes, nearest first, then sorted by path.",
      "items": {
        "$ref": "#/$defs/Dependent"
      },
      "type": "array"
    },
    "obligations": {
      "description": "Obligations that go stale or whose verdict may change.",
      "items": {
        "$ref": "#/$defs/Obligation"
      },
      "type": "array"
    },
    "path": {
      "description": "The path asked about.",
      "type": "string"
    },
    "schema": {
      "const": "cadetta.impact/1"
    }
  },
  "required": [
    "schema",
    "path",
    "dependents",
    "obligations"
  ],
  "title": "ImpactOutput",
  "type": "object"
}
