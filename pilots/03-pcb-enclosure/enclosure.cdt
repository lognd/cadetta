namespace acme.pienclosure

/// Raspberry Pi 4 Model B. Datum: board lower-left corner seen from the top,
/// X along the 85mm edge, Y along the 56mm edge, Z up from the PCB top face.
/// Cutout centres below are the official drawing's dimensions from that datum.
ots RaspberryPi4B {
  source "https://datasheets.raspberrypi.com/rpi4/raspberry-pi-4-mechanical-drawing.pdf"

  board_length = 85mm
  board_width = 56mm
  thickness = 1.4mm source "not on the drawing; typical Pi PCB, verified by caliper"
  corner_radius = 3mm

  /// Hole 1 centre; holes are 3.5mm from the left and bottom edges.
  hole_inset = 3.5mm
  hole_pitch_x = 58mm
  hole_pitch_y = 49mm
  hole_diameter = 2.7mm
  hole_pad_diameter = 6.2mm         // keep-out for the standoff top, drawing note

  // Hole centres. PROPOSED: a 2D point type; here every coordinate is its own parameter.
  hole_a_x = 3.5mm
  hole_a_y = 3.5mm
  hole_b_x = 61.5mm
  hole_b_y = 3.5mm
  hole_c_x = 3.5mm
  hole_c_y = 52.5mm
  hole_d_x = 61.5mm
  hole_d_y = 52.5mm

  // Bottom long edge (Y = 0), connector centre positions along X.
  usbc_x = 11.2mm
  hdmi0_x = 26mm
  hdmi1_x = 39.5mm
  // Right short edge (X = 85), connector centre positions along Y.
  ethernet_y = 10.25mm
  usb_lower_y = 29mm
  usb_upper_y = 47mm

  // Receptacle body sizes (width along its edge x height above the PCB top).
  usbc_width = 9mm
  usbc_height = 3.3mm
  hdmi_width = 6.6mm
  hdmi_height = 3.1mm
  ethernet_width = 16mm
  ethernet_height = 13.5mm
  usb_width = 13.1mm
  usb_height = 15.6mm
  tallest_component = 17mm          // top of the stacked USB receptacle incl. shell, with margin
  underside_relief = 1.5mm          // solder-tail height under the PCB
}

/// Heat-set insert, M2.5 x 4 straight knurled brass (CNC Kitchen style, generic vendor data).
ots Insert {
  source "https://www.cnckitchen.com/blog/tipps-amp-tricks-fr-gewindeeinstze-im-3d-druck"
  thread_diameter = 2.5mm
  outer_diameter = 3.6mm
  length = 4mm
  recommended_hole = 3.2mm          // drawn hole for the insert; melts into the wall
}

/// PETG on a 0.4mm nozzle FDM printer. Process facts measured on our printer.
ots Fdm {
  source "calibration coupon print 2026-09-30, caliper"
  nozzle = 0.4mm
  line_width = 0.45mm
  layer_height = 0.2mm
  hole_undersize = 0.2mm +- 0.05mm  // printed holes come out small by this much (diameter)
  boss_oversize = 0.1mm             // external features come out large (per feature, not per side)
  slot_undersize = 0.2mm            // rectangular cutouts shrink the same way
  shrinkage = 0.4%
  infill = 20%
  perimeters: Count = 6
}

model Case {
  /// Material around the cavity.
  wall: Length = Fdm.perimeters * Fdm.line_width       // Count * Length: anonymous kind, assignable to Length (quantities 4.3-4.4)
  floor_thickness = 2.4mm
  lid_thickness = 2.4mm
  board_clearance = 1mm             // gap between PCB edge and the inner wall
  top_clearance = 2mm               // gap between tallest component and the lid
  standoff_height = Insert.length + 1mm                // insert depth plus floor-side web
  standoff_count: Count = 4

  cavity_length = RaspberryPi4B.board_length + 2 * board_clearance
  cavity_width = RaspberryPi4B.board_width + 2 * board_clearance
  cavity_height = standoff_height + RaspberryPi4B.thickness + RaspberryPi4B.tallest_component + top_clearance

  outer_length = cavity_length + 2 * wall
  outer_width = cavity_width + 2 * wall
  outer_height = floor_thickness + cavity_height + lid_thickness

  /// Offset of the Pi datum from the outer lower-left corner of the base.
  datum_x = wall + board_clearance
  datum_y = wall + board_clearance
  /// Z of the PCB top face above the base outer bottom.
  board_top_z = floor_thickness + standoff_height + RaspberryPi4B.thickness

  // Standoff sizing
  insert_hole = Insert.recommended_hole + Fdm.hole_undersize
  standoff_diameter = RaspberryPi4B.hole_pad_diameter
  locating_pin = RaspberryPi4B.hole_diameter - 0.2mm - Fdm.boss_oversize

  // Screw clearance hole in the lid? Lid is retained by 4 more inserts in the base corners.
  lid_screw_hole = 2.5mm + 0.4mm + Fdm.hole_undersize
}

model Base {
  // Standoff centres in the base frame, all derived from the Pi datum.
  standoff_a_x = Case.datum_x + RaspberryPi4B.hole_a_x
  standoff_a_y = Case.datum_y + RaspberryPi4B.hole_a_y
  standoff_b_x = Case.datum_x + RaspberryPi4B.hole_b_x
  standoff_b_y = Case.datum_y + RaspberryPi4B.hole_b_y
  standoff_c_x = Case.datum_x + RaspberryPi4B.hole_c_x
  standoff_c_y = Case.datum_y + RaspberryPi4B.hole_c_y
  standoff_d_x = Case.datum_x + RaspberryPi4B.hole_d_x
  standoff_d_y = Case.datum_y + RaspberryPi4B.hole_d_y

  /// Pairs of cutout margin: drawn size = receptacle + plug allowance + FDM shrink.
  plug_allowance = 1mm
  usbc_cut_width = round_to(RaspberryPi4B.usbc_width + 3.5mm + Fdm.slot_undersize, 0.1mm)   // overmold ~12.5mm
  usbc_cut_height = round_to(RaspberryPi4B.usbc_height + 3mm + Fdm.slot_undersize, 0.1mm)
  hdmi_cut_width = round_to(RaspberryPi4B.hdmi_width + 4.5mm + Fdm.slot_undersize, 0.1mm)    // overmold ~11mm
  hdmi_cut_height = round_to(RaspberryPi4B.hdmi_height + 3mm + Fdm.slot_undersize, 0.1mm)
  ethernet_cut_width = round_to(RaspberryPi4B.ethernet_width + plug_allowance + Fdm.slot_undersize, 0.1mm)
  ethernet_cut_height = round_to(RaspberryPi4B.ethernet_height + plug_allowance + Fdm.slot_undersize, 0.1mm)
  usb_cut_width = round_to(RaspberryPi4B.usb_width + plug_allowance + Fdm.slot_undersize, 0.1mm)
  usb_cut_height = round_to(RaspberryPi4B.usb_height + plug_allowance + Fdm.slot_undersize, 0.1mm)

  // Front wall (Y = 0 side): cutout centres along X, from the Pi datum.
  usbc_cut_x = Case.datum_x + RaspberryPi4B.usbc_x
  hdmi0_cut_x = Case.datum_x + RaspberryPi4B.hdmi0_x
  hdmi1_cut_x = Case.datum_x + RaspberryPi4B.hdmi1_x
  usbc_cut_z = Case.board_top_z + RaspberryPi4B.usbc_height / 2
  hdmi_cut_z = Case.board_top_z + RaspberryPi4B.hdmi_height / 2

  // Right wall (X = max): cutout centres along Y.
  ethernet_cut_y = Case.datum_y + RaspberryPi4B.ethernet_y
  usb_lower_cut_y = Case.datum_y + RaspberryPi4B.usb_lower_y
  usb_upper_cut_y = Case.datum_y + RaspberryPi4B.usb_upper_y
  ethernet_cut_z = Case.board_top_z + RaspberryPi4B.ethernet_height / 2
  usb_cut_z = Case.board_top_z + RaspberryPi4B.usb_height / 2
}

model Lid {
  /// Lid pocket depth that overlaps the base lip.
  lip_depth = 2mm
  lip_clearance = 0.3mm + Fdm.slot_undersize     // PROPOSED: sign differs for inner vs outer mating faces
  screw_hole = Case.lid_screw_hole
}

assembly PiCase {
  part base: Base
  part lid: Lid

  check stack_fits: Case.cavity_height > RaspberryPi4B.tallest_component + RaspberryPi4B.thickness
  check wall_is_printable: Case.wall >= 4 * Fdm.nozzle
  check usbc_clears_corner: base.usbc_cut_x - base.usbc_cut_width / 2 > Case.wall + RaspberryPi4B.corner_radius "USB-C cutout runs into the corner radius"
  check hdmi_web: base.hdmi1_cut_x - base.hdmi0_cut_x - base.hdmi_cut_width >= 2 * Fdm.line_width "web between HDMI cutouts too thin to print"
  check ethernet_vs_usb: base.usb_lower_cut_y - base.ethernet_cut_y > base.usb_cut_width / 2 + base.ethernet_cut_width / 2 "cutouts overlap"
  check mounting_pattern: RaspberryPi4B.hole_inset + RaspberryPi4B.hole_pitch_y == RaspberryPi4B.board_width - RaspberryPi4B.hole_inset
  check insert_hole_fits: Case.insert_hole < Case.standoff_diameter - 2 * Fdm.line_width
}

// No fit declared for the locating pin: ISO 286 classes do not apply to a printed pin,
// so the pin/hole clearance is the explicit 0.2mm in Case.locating_pin.
