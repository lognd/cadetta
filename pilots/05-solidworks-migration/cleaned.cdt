namespace acme.gearbox

import std.fits.iso286

/// ISO 273 clearance holes for metric bolts.
ots Iso273 {
  source "ISO 273:1979 Table 1, M6, medium series (class H13)"

  m6_clearance: Length = 6.6mm H13
}

/// ISO 4762 M6 socket head cap screw, product grade A.
ots Iso4762M6 {
  source "ISO 4762:2004 Table 1, M6 (ds, dk, k limits)"

  shank_dia   = 6mm +0mm -0.18mm       // ds max 6.00, min 5.82
  head_dia    = 10mm +0mm -0.22mm      // dk max 10.00, min 9.78
  head_height = 6mm +0mm -0.3mm        // k max 6.00, min 5.70
}

/// Gearbox cover plate, 6061-T6 plate stock.
model CoverPlate {
  length        = 120mm                was d1_sketch1
  width         = 80mm                 was d2_sketch1
  corner_radius = 5mm                  was d3_sketch1
  bolt_pitch_x  = 100mm                was d4_sketch1
  bolt_pitch_y  = 60mm                 was d5_sketch1
  hole_dia: Length = Iso273.m6_clearance   was d6_sketch1

  /// Pilot bore. 12.012 in the legacy file was a hand-typed point inside H7
  /// (12.000..12.018); we declare the class and emit the midpoint 12.009.
  @emit(mid)
  pilot_bore    = 12mm H7              was d7_sketch1

  /// Stock thickness, 1/4 in nominal. Legacy had it twice (6.35mm, 0.25in).
  thickness     = 0.25in source "ASTM B209 6061-T6 plate, 1/4 in nominal" was d1_boss_extrude1 was Globals.plate_thk // PROPOSED: was cannot name another component; legacy Plate_Thk global would keep its binding
  cbore_dia     = 11mm H13 source "DIN 974-1 counterbore for M6 cap screw" was d1_sketch2

  /// Counterbore depth, half the plate.
  cbore_depth: Length = thickness / 2  was d1_cut_extrude1
}

/// Gasket, same outline and hole pattern as the cover plate.
model Gasket {
  length        = CoverPlate.length          was d1_sketch1
  width         = CoverPlate.width           was d2_sketch1
  corner_radius = CoverPlate.corner_radius   was d3_sketch1
  bolt_pitch_x  = CoverPlate.bolt_pitch_x    was d4_sketch1
  bolt_pitch_y  = CoverPlate.bolt_pitch_y    was d5_sketch1
  hole_dia: Length = Iso273.m6_clearance     was d6_sketch1

  @emit(mid)                                  // not inherited from CoverPlate; repeated on purpose
  pilot_bore    = CoverPlate.pilot_bore      was d7_sketch1

  thickness     = 1.5mm                      was d1_boss_extrude1
}

/// Cap screw as modeled in SOLIDWORKS.
model Bolt {
  shank_dia   = Iso4762M6.shank_dia       was d1_sketch1
  head_dia    = Iso4762M6.head_dia        was d2_sketch1
  head_height = Iso4762M6.head_height     was d1_boss_extrude1

  /// 0.75in is not a standard M6 length (16, 20 mm); kept from legacy, review.
  length      = 0.75in                    was d1_boss_extrude2
  thread_depth: Length = length - CoverPlate.thickness - Gasket.thickness  was d1_sketch3
}

assembly GearboxCover {
  part plate: CoverPlate
  part gasket: Gasket
  part bolt: Bolt

  bolt_count: Count = 4                   was num_bolts // PROPOSED: legacy NumBolts was in Globals; cross-component move

  check cbore_clears_head: plate.cbore_dia > bolt.head_dia "counterbore must clear head"
  check hole_clears_shank: plate.hole_dia > bolt.shank_dia
}

// Coincidences that D002 reads as "exactly twice another value".
waive D002 on acme.gearbox::CoverPlate.length {
  because "120 = 2 x 60 is dimensional coincidence, not a rule"
}
waive D002 on acme.gearbox::Iso4762M6.head_dia {
  because "10 = 2 x 5 is the ISO table, unrelated to plate corner radius"
}
waive D002 on acme.gearbox::CoverPlate.pilot_bore {
  because "12 H7 is a bore size, 2 x shank diameter by coincidence"
}
