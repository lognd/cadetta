// Scaffolded by: cadetta import sw-equations legacy-equations.txt --assume-unit mm
// Provenance in the IR is imported{adapter=sw-equations, file, native_name} per param.
// Names are the importer's deterministic proposal; every value is as found.
namespace acme.gearbox

/// Gearbox cover - plate + gasket + bolts - linked equations
/// JW 2019-03 / edits MK 2022-11 (added gasket), dont touch the 6.35 thing
// PROPOSED: no spec rule says which component owns file-level global variables;
// importer invents "Globals" (here) -- spec needs a stated rule.
model Globals {
  source "legacy-equations.txt"

  plate_thk       = 6.35mm
  plate_thickness = 0.25in
  plate_l         = 120mm
  plate_w         = 80mm            // unit assumed: bare 80 in file, --assume-unit mm
  corner_r        = 5mm
  bolt_spacing_x  = 100mm
  bolt_spacing_y  = 60mm            // unit assumed
  /// M6 clearance
  dia             = 6.6mm
  bolt_dia_mm     = 6mm
  bolt_head_dia   = 10mm
  bolt_head_h     = 6mm
  bolt_len_in     = 0.75in
  /// pilot
  pilot_bore      = 12.012mm
  gasket_thk      = 1.5mm
  num_bolts: Count = 4
}

model CoverPlate {
  source "legacy-equations.txt"

  d1_sketch1        = Globals.plate_l
  d2_sketch1        = Globals.plate_w
  d3_sketch1        = Globals.corner_r
  d4_sketch1        = Globals.bolt_spacing_x
  d5_sketch1        = Globals.bolt_spacing_y
  d6_sketch1        = Globals.dia
  d7_sketch1        = Globals.pilot_bore
  d1_boss_extrude1  = Globals.plate_thk
  d1_sketch2        = Globals.bolt_head_dia + 1mm
  /// cbore depth
  d1_cut_extrude1   = Globals.plate_thickness / 2
}

model Gasket {
  source "legacy-equations.txt"

  d1_sketch1        = Globals.plate_l
  d2_sketch1        = Globals.plate_w
  d3_sketch1        = 5mm
  d4_sketch1        = 100mm
  d5_sketch1        = Globals.bolt_spacing_y
  d6_sketch1        = 6.6mm
  d7_sketch1        = 12.012mm
  d1_boss_extrude1  = Globals.gasket_thk
}

model Bolt {
  source "legacy-equations.txt"

  d1_sketch1        = Globals.bolt_dia_mm
  d2_sketch1        = Globals.bolt_head_dia
  d1_boss_extrude1  = Globals.bolt_head_h
  d1_boss_extrude2  = Globals.bolt_len_in
  /// thread depth
  d1_sketch3        = Globals.bolt_len_in - Globals.plate_thk - Globals.gasket_thk
}
