// Off-the-shelf motion hardware, as families where the vendor sells a range.
namespace acme.parts.motion

use std.fasteners::MetricThread          // PROPOSED: spec examples write `std::fasteners::...`; grammar says dotted path then `::`

cite steppero = "StepperOnline 17HS16-2004S1 datasheet, p.1"
cite nema     = "NEMA ICS 16 frame 17"
cite coupler  = "Misumi MCKN19-5-8 drawing"
cite iso2904  = "ISO 2904:1977 trapezoidal thread basic dimensions"
cite screwds  = "Generic T8 lead screw datasheet (verify rev.)"
cite nutds    = "Generic T8 anti-backlash flange nut drawing"
cite hiwin    = "HIWIN MG series catalog, MGN12 (verify rev.)"
cite matweb   = "https://asm.matweb.com/"

// ---------------------------------------------------------------- materials
enum Material { Al6061T6, Al5052 }

table Materials @matweb {
  key material: Material
  cols density: Density
  Al6061T6 => 2.70g/cm^3
  Al5052   => 2.68g/cm^3
}

// ---------------------------------------------------------------- interfaces
/// What a drivetrain needs from a motor.
interface Stepper {
  holding_torque: Torque
  step_angle: Angle
}

/// What a drivetrain needs from a screw.
interface LeadScrew {
  pitch_diameter: Length
  flank_half_angle: Angle
  lead: Lead                              // Length/Angle, angle exponent -1
}

// ---------------------------------------------------------------- motor, coupler
ots Nema17Motor: Stepper @steppero {
  face_width      = 42.3mm [+-0.2mm]     @nema
  body_length     = 40mm [+-1mm]
  hole_pitch      = 31mm [+-0.1mm]       @nema:"4 x M3 on a 31 mm square"
  thread_depth    = 4.5mm
  pilot_diameter  = 22mm [+0 -0.05mm]    // drawing value, not an ISO 286 class
  pilot_height    = 2mm
  shaft_diameter  = 5mm [+0 -0.013mm]
  shaft_length    = 24mm                 // from flange face, includes D-flat
  holding_torque  = 0.45N*m
  step_angle      = 1.8deg
  rated_current   = 2A
  rotor_inertia   = 82g*cm^2
  mass            = 0.28kg
}

ots FlexCoupler @coupler {
  outer_diameter           = 19mm
  length                   = 25mm
  bore_motor_side          = 5mm H7
  bore_screw_side          = 8mm H7
  bore_depth               = 10mm        // per side
  rated_torque             = 1.2N*m
  max_speed                = 6000rpm
  max_angular_misalignment = 5deg
}

// ---------------------------------------------------------------- lead screw family
enum TrThread { Tr8P2, Tr10P2 }

table Iso2904 @iso2904 {
  key thread: TrThread
  cols major: Length, pitch: Length, pitch_diameter: Length
  Tr8P2  => 8mm,  2mm, 7mm
  Tr10P2 => 10mm, 2mm, 9mm
}

/// Trapezoidal lead screw cut to `length`; `starts` turns pitch into lead.
ots TrScrew(thread: TrThread, starts: Count, length: Length): LeadScrew @screwds {
  major_diameter   = Iso2904[thread].major
  pitch            = Iso2904[thread].pitch
  pitch_diameter   = Iso2904[thread].pitch_diameter
  lead: Lead       = pitch * starts / 1rev       // 2 mm * 4 / rev = 8mm/rev
  flank_half_angle = 15deg
  cut_increment    = 5mm                         // vendor cuts to multiples of this
}

ots BrassNut @nutds {
  length               = 24mm
  body_diameter        = 10mm
  flange_diameter      = 22mm
  flange_thickness     = 3.5mm
  bolt_circle_diameter = 16mm
  mount_hole_diameter  = 3.4mm
  mount_hole_count: Count = 4
  mass                 = 25g
}

// ---------------------------------------------------------------- linear guide
/// MGN12 rail cut to `length` from stock.
ots Mgn12Rail(length: Length) @hiwin {
  width                = 12mm
  height               = 8mm
  hole_pitch           = 25mm
  end_distance         = 10mm
  stock_step           = 50mm
  mount_hole_diameter  = 3.5mm
  counterbore_diameter = 6mm
  counterbore_depth    = 4.5mm
  hole_count: Count    = floor_to((length - 2 * end_distance) / hole_pitch, 1) + 1   // PROPOSED: floor(x) -> Count; floor_to needs a bare step and `+ 1` on a dimensionless result is unclear
}

ots Mgn12hCarriage @hiwin {
  total_height        = 13mm
  width               = 27mm
  length              = 45.4mm
  hole_spacing_across = 20mm
  hole_spacing_along  = 20mm
  dynamic_load        = 3.43kN
  static_load         = 5.15kN
  mass                = 90g
}
