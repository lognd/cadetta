// 300 mm linear actuator: NEMA 17, Tr8x8(P2) screw, twin MGN12 rails.
// One file, one namespace; the 608 comes from the shared library namespace.
namespace acme.actuator

use acme.parts.bearings::Bearing608
use acme.parts.motion::{Nema17Motor, FlexCoupler, TrScrew, TrThread, BrassNut}
use acme.parts.motion::{Mgn12Rail, Mgn12hCarriage, Stepper, LeadScrew, Material, Materials}
use std.fasteners::{Iso273, Iso4762, MetricThread}

// ======================================================================
// Drivetrain. Angle exponents (quantities.md 4.3): Torque -1, Lead -1,
// AngularVelocity +1, Angle +1, all else 0. Hand check of the 4.3 table:
//   1500rpm * 8mm/rev -> Velocity : +1 + -1 = 0  clean, 25 rev/s * 8mm = 200mm/s
//   0.45N*m*eta / 8mm/rev -> Force: -1 - -1 = 0  clean, = 2*pi*T*eta/0.008m
//   thrust * lead -> Energy       : 0 + -1 = -1  Q008, so `* 1rev` is written
//   lead / Count -> Length        : -1         Q008, so `* 1rev` is written
// ======================================================================
model Drivetrain(motor: Stepper, screw: LeadScrew) {
  /// Pull-out derate at running speed.
  torque_ratio: Ratio = 50%                         @assumed:"vendor curve, 600 rpm"
  running_torque: Torque = motor.holding_torque * torque_ratio
  /// Dry brass on stainless.
  friction_coefficient: Ratio = 0.15                @assumed:"Machinery's Handbook 0.1 to 0.2"

  /// Travel per revolution; Lead * Angle is exponent 0, so no Q008.
  travel_per_rev: Length = screw.lead * 1rev
  /// Circumference at the pitch diameter; `/ 1rad` drops the +1 explicitly.
  circumference: Length = 1rev * (screw.pitch_diameter / 2) / 1rad
  lead_angle: Angle = atan2(travel_per_rev, circumference)      #[display(deg)]
  friction_angle: Angle = atan2(friction_coefficient, cos(screw.flank_half_angle))   #[display(deg)]
  efficiency: Ratio = tan(lead_angle) / tan(lead_angle + friction_angle)   #[display(%)]

  /// Axial thrust. Exponent 0, so the 2*pi is inside Lead (8mm/rev), not written.
  thrust: Force = running_torque * efficiency / screw.lead
  work_in: Energy = running_torque * 1rev
  work_out: Energy = thrust * screw.lead * 1rev
  check energy_balance: work_out <= work_in "efficiency above 100 percent"

  motor_speed: AngularVelocity = 600rpm
  max_speed: Velocity = motor_speed * screw.lead              // exactly 80mm/s; pi cancels

  steps_per_rev: Count = 360deg / motor.step_angle            // exactly 200
  microsteps: Count = 16
  linear_resolution: Length = travel_per_rev / (steps_per_rev * microsteps)   // exactly 1/400 mm
  step_rate: Frequency = motor_speed * steps_per_rev * microsteps / 1rev      // exactly 32kHz
}

// ======================================================================
// Structure.
// ======================================================================
/// 6 mm plate carrying the motor.
model MotorMount(motor: Nema17Motor, thread: MetricThread, screw_length: Length, axis_height: Length) {
  fit pilot = H8 on motor.pilot_diameter
  material = Material::Al6061T6
  thickness = 6mm
  width = 60mm
  height = 60mm
  pilot_bore = pilot.hole                                     #[emit(mid)]
  hole_pitch = motor.hole_pitch.nominal [+-0.05mm]            // tighter than the motor's own +-0.1
  bolt_circle_diameter = sqrt(2 * hole_pitch.nominal^2)       // inexact by construction
  clearance_hole_diameter = Iso273[thread].medium
  screw_engagement = screw_length - thickness
  mass = Materials[material].density * thickness * width * height
}

/// Floating-end bearing housing.
model EndBlock(bearing: Bearing608, axis_height: Length) {
  fit seat = H7 on bearing.outer_diameter
  seat_bore = seat.hole                                       #[emit(mid)]
  seat_depth = bearing.width.nominal + 0.1mm
  back_wall = 5mm
  thickness = seat_depth + back_wall
  through_bore = 10mm
  height = axis_height + bearing.outer_diameter.nominal / 2 + back_wall
}

/// Plate bridging the two carriages and holding the nut.
model CarriagePlate(nut: BrassNut, rail_spacing: Length, carriage: Mgn12hCarriage) {
  fit nut_relief = H11/c11 on nut.body_diameter
  material = Material::Al6061T6
  thickness = 6mm
  length = 80mm
  width = rail_spacing + carriage.width
  nut_relief_bore = nut_relief.hole                           #[emit(mid)]
  mass = Materials[material].density * thickness * width * length
}

// ======================================================================
// Assembly.
// ======================================================================
assembly Actuator {
  travel            = 300mm                  was stroke
  axis_height       = 25mm
  rail_spacing      = 60mm
  overtravel_margin = 5mm
  payload_mass      = 5kg
  required_accel    = 5m/s^2
  required_speed    = 50mm/s
  rail_friction: Ratio = 1%
  safety_factor: Ratio = 2
  controller_max_step_rate = 100kHz
  mount_thread      = MetricThread::M3
  mount_screw_len   = 10mm

  coupler_to_nut_gap = 5mm
  nut_to_bearing_gap = 5mm
  journal_overhang   = 3mm

  part motor: Nema17Motor
  part coupler: FlexCoupler
  part nut: BrassNut
  part bearing: Bearing608
  part carriage[2]: Mgn12hCarriage
  part mount_screw[4]: Iso4762(mount_thread, mount_screw_len)

  /// Cut length: ceil to the vendor increment; exact fit stays put (ties go up only above).
  screw_min_length = coupler.bore_depth + coupler_to_nut_gap + nut.length + travel
                   + nut_to_bearing_gap + bearing.width.nominal + journal_overhang
  screw_length = ceil_to(screw_min_length, screw.cut_increment)   // PROPOSED: self-reference through the part's own argument; need class-level access to length-independent ots members
  part screw: TrScrew(thread = TrThread::Tr8P2, starts = 4, length = screw_length)

  rail_min_length = travel + carriage[0].length + 2 * overtravel_margin
  rail_length = ceil_to(rail_min_length, rail[0].stock_step)      // PROPOSED: same self-reference
  part rail[2]: Mgn12Rail(length = rail_length)

  part drive: Drivetrain(motor = motor, screw = screw)
  part motor_mount: MotorMount(motor = motor, thread = mount_thread,
                               screw_length = mount_screw_len, axis_height = axis_height)
  part end_block: EndBlock(bearing = bearing, axis_height = axis_height)
  part plate: CarriagePlate(nut = nut, rail_spacing = rail_spacing, carriage = carriage[0])

  /// 8 mm journal in the 608 bore; transition range is the point of the check.
  fit journal = g6 on bearing.bore [0um .. 20um]
  /// Coupler bore on motor shaft: free fit, both sides vendor-toleranced.
  fit motor_shaft = coupler.bore_motor_side / motor.shaft_diameter [0um .. 30um]

  moving_mass: Mass = payload_mass + plate.mass + sum(carriage.mass) + nut.mass
  required_thrust: Force = safety_factor * moving_mass * (required_accel + 1gn * rail_friction)
  shaft_stickout = motor.shaft_length - motor_mount.thickness
  coupler_start = shaft_stickout - coupler.bore_depth
  overhang = screw_length - screw_min_length + journal_overhang

  check thrust_margin: drive.thrust >= required_thrust "thrust below load requirement"
  check speed_margin: drive.max_speed >= required_speed
  check step_rate_ok: drive.step_rate <= controller_max_step_rate
  check coupler_torque: motor.holding_torque <= coupler.rated_torque
  check coupler_clears_plate: coupler_start >= 2mm
  check shaft_engaged: 0mm <= coupler.bore_depth <= shaft_stickout
  check overhang_in_wall: overhang <= end_block.back_wall
  check engagement: mount_screw[0].thread_diameter <= motor_mount.screw_engagement <= motor.thread_depth   // member name assumed on std Iso4762
  check motor_clears_base: axis_height - motor.face_width / 2 >= 2mm
  check nut_clears_base: axis_height - nut.flange_diameter / 2 >= 2mm
  check nut_between_carriages: rail_spacing - carriage[0].width >= nut.flange_diameter + 2mm
  check for c in carriage: c.static_load >= 10 * moving_mass * 1gn
}

waive C002 on acme.actuator::Actuator.journal {
  because "g6 journal vs P0 bore can touch by 3 um at extremes; floating end, accepted"
  expires 2027-06-30
}
