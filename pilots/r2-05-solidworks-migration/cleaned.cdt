namespace acme.gearbox

use std::fits::iso286
use std::fasteners::MetricThread
use std::tables::Iso273      // PROPOSED: spec ships ISO 273 but names no module path for shipped tables

cite iso4762 = std.iso4762

/// ISO 4762 M6 socket head cap screw, product grade A.
ots Iso4762M6 @iso4762 {
  shank_dia   = 6mm [+0 -0.18mm]     @iso4762:"Table 1, ds max 6.00 min 5.82"
  head_dia    = 10mm [+0 -0.22mm]    @iso4762:"Table 1, dk max 10.00 min 9.78"
  head_height = 6mm [+0 -0.3mm]      @iso4762:"Table 1, k max 6.00 min 5.70"
}

/// Gearbox cover plate, 6061-T6 plate stock.
model CoverPlate {
  length        = 120mm        was d1_sketch1 was Globals.plate_l
  width         = 80mm         was d2_sketch1 was Globals.plate_w
  corner_radius = 5mm          was d3_sketch1 was Globals.corner_r
  bolt_pitch_x  = 100mm        was d4_sketch1 was Globals.bolt_spacing_x
  bolt_pitch_y  = 60mm         was d5_sketch1 was Globals.bolt_spacing_y
  hole_dia      = Iso273[MetricThread::M6].medium   was d6_sketch1 was Globals.dia

  /// Pilot bore. 12.012 in the legacy file was a hand-typed point inside H7
  /// (12.000..12.018); we declare the class and emit the midpoint 12.009.
  pilot_bore    = 12mm H7      was d7_sketch1 was Globals.pilot_bore   #[emit(mid)]

  /// Stock thickness, 1/4 in nominal. Legacy had it twice (6.35mm, 0.25in).
  thickness     = 0.25in       @"ASTM B209 6061-T6 plate, 1/4 in nominal" was d1_boss_extrude1 was Globals.plate_thk was Globals.plate_thickness

  cbore_dia     = Bolt.head_dia + 1mm   was d1_sketch2
  /// Counterbore depth, half the plate.
  cbore_depth   = thickness / 2         was d1_cut_extrude1
}

/// Gasket, same outline and hole pattern as the cover plate.
model Gasket {
  length        = CoverPlate.length          was d1_sketch1
  width         = CoverPlate.width           was d2_sketch1
  corner_radius = CoverPlate.corner_radius   was d3_sketch1
  bolt_pitch_x  = CoverPlate.bolt_pitch_x    was d4_sketch1
  bolt_pitch_y  = CoverPlate.bolt_pitch_y    was d5_sketch1
  hole_dia      = CoverPlate.hole_dia        was d6_sketch1
  pilot_bore    = CoverPlate.pilot_bore      was d7_sketch1   #[emit(mid)]   // PROPOSED: emit point should follow a pure reference; today it must be repeated
  thickness     = 1.5mm                      was d1_boss_extrude1 was Globals.gasket_thk
}

/// Cap screw as modeled in SOLIDWORKS.
model Bolt {
  shank_dia    = Iso4762M6.shank_dia     was d1_sketch1 was Globals.bolt_dia_mm
  head_dia     = Iso4762M6.head_dia      was d2_sketch1 was Globals.bolt_head_dia
  head_height  = Iso4762M6.head_height   was d1_boss_extrude1 was Globals.bolt_head_h

  /// 0.75in is not a standard M6 length (16, 20 mm); kept from legacy, review.
  length       = 0.75in                  was d1_boss_extrude2 was Globals.bolt_len_in
  thread_depth = length - CoverPlate.thickness - Gasket.thickness   was d1_sketch3
}

assembly GearboxCover {
  bolt_count: Count = 4                  was Globals.num_bolts

  part plate: CoverPlate
  part gasket: Gasket
  part bolt[bolt_count]: Bolt

  check for b in bolt: plate.cbore_dia > b.head_dia "counterbore must clear head"
  check for b in bolt: plate.hole_dia > b.shank_dia
}
