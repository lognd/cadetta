// Shared parts library: off-the-shelf bearings. Any project imports this file;
// the 608 is the same physical part wherever it is used, so it is stated once.
namespace acme.parts.bearings

/// 608 deep-groove ball bearing, ISO 15 / ISO 492 normal (P0) tolerance class.
ots Bearing608 {
  source "ISO 15:2017 table, boundary dim 8x22x7; deviations ISO 492:2014 table 4 (P0), SKF 608 product sheet"

  /// Inner ring bore. ISO 492 P0: 0 / -8 um for d = 6..10 mm. Not an ISO 286 class.
  bore = 8mm +0mm -0.008mm
  /// Outer ring diameter. ISO 492 P0: 0 / -9 um for D = 18..30 mm (numerically equals h5).
  outer_diameter = 22mm +0mm -0.009mm
  width = 7mm +0mm -0.12mm
  /// Minimum chamfer (corner radius) on rings, shaft and housing corners must clear it.
  min_chamfer = 0.3mm
  dynamic_load = 3.45kN
  static_load = 1.37kN
  limiting_speed = 28000rpm   // grease, ZZ shields; SKF sheet
  mass = 12g
}
