namespace acme.actuator

import acme.parts.motion
import acme.parts.bearings

/// 300 mm linear actuator: NEMA 17, T8x8 screw, twin MGN12 rails.
assembly Actuator {
  part motor: Nema17Motor
  part coupler: FlexCoupler
  part screw: Screw
  part nut: BrassNut
  part drive: Drivetrain
  part motor_mount: MotorMount
  part end_block: EndBlock
  part bearing: Bearing608
  part rail_left: RailCut
  part rail_right: RailCut
  part carriage_left: Mgn12hCarriage
  part carriage_right: Mgn12hCarriage
  part plate: CarriagePlate
  part mount_screw: ShcsM3x10

  // Requirements and layout choices (assembly-level parameters).
  travel = 300mm                       was stroke
  axis_height = 25mm
  rail_spacing = 60mm
  overtravel_margin = 5mm
  gravity = 9.80665m/s^2               // standard gravity, exact by definition
  payload_mass = 5kg
  required_accel = 5m/s^2
  required_speed = 50mm/s
  rail_friction: Ratio = 0.01
  safety_factor: Ratio = 2
  controller_max_step_rate = 100kHz

  moving_mass: Mass = payload_mass + plate.mass + carriage_left.mass + carriage_right.mass + nut.mass
  required_thrust: Force = safety_factor * moving_mass * (required_accel + gravity * rail_friction)

  /// Plate outer face to start of the coupler (motor shaft stick-out less engagement).
  shaft_stickout = motor.shaft_length - motor_mount.thickness
  coupler_start = shaft_stickout - coupler.bore_depth

  check travel_fits_screw: travel + nut.length <= screw.length - coupler.bore_depth - 5mm
  check travel_fits_rail: travel + carriage_left.length + 2 * overtravel_margin <= rail_left.length
  check rails_match: rail_left.length == rail_right.length
  check thrust_margin: drive.thrust >= required_thrust "thrust below load requirement"
  check speed_margin: drive.max_speed >= required_speed
  check step_rate_ok: drive.step_rate <= controller_max_step_rate
  check energy_balance: drive.work_out <= drive.work_in "efficiency above 100 percent"
  check coupler_torque: motor.holding_torque <= coupler.rated_torque
  check coupler_bore_free: coupler.bore_motor_side >= motor.shaft_diameter
  check coupler_clears_plate: coupler_start >= 2mm
  check shaft_engaged: coupler.bore_depth <= shaft_stickout
  check journal_clearance: bearing.bore >= screw.journal_diameter "journal must not be tighter than the bore"
  check overhang_in_wall: screw.overhang <= end_block.back_wall
  check engagement_min: motor_mount.screw_engagement >= mount_screw.thread_diameter
  check engagement_max: motor_mount.screw_engagement <= motor.thread_depth
  check motor_clears_base: axis_height - motor.face_width / 2 >= 2mm
  check nut_clears_base: axis_height - nut.flange_diameter / 2 >= 2mm
  check nut_between_carriages: rail_spacing - carriage_left.width >= nut.flange_diameter + 2mm
  check carriage_static: carriage_left.static_load >= 10 * moving_mass * gravity
}

waive D002 on acme.parts.motion::T8LeadScrew.lead {
  because "datasheet prints lead; lead_consistent check ties it to pitch*starts"
}

waive C002 on acme.actuator::Actuator.journal_clearance {
  because "g6 journal vs P0 bore can touch by 3 um at extremes; floating end, accepted"
  expires 2027-06-30
}
