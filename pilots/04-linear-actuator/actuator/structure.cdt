namespace acme.actuator

import acme.parts.motion
import acme.parts.bearings

/// Pilot of the motor boss in the mount plate: locational clearance.
fit mount_pilot = H8/h9 on Nema17Motor.pilot_diameter
/// Outer ring of the 608 in the end block housing.
fit bearing_seat = H7/h5 on Bearing608.outer_diameter
/// Nut body through the carriage tab: loose running clearance.
fit nut_relief = H11/c11 on BrassNut.body_diameter

/// 6 mm aluminium plate carrying the motor.
model MotorMount {
  thickness = 6mm
  width = 60mm
  height = 60mm
  @emit(mid)
  pilot_bore = mount_pilot.hole
  /// Hole spacing of the clearance holes, tighter than the motor's own +-0.1 mm.
  hole_pitch = nominal(Nema17Motor.hole_pitch) +- 0.05mm   // PROPOSED: nominal() and applying a tolerance to an expression
  /// Diagonal of the 31 mm square: sqrt(2) * pitch, inexact by construction.
  bolt_circle_diameter = sqrt(2 * nominal(hole_pitch)^2)
  clearance_hole_diameter = 3.4mm      // ISO 273 medium series for M3
  bolt_count: Count = 4
  /// Where the screw tip bottoms in the motor flange.
  screw_engagement = ShcsM3x10.length - thickness
  /// Axis height above the base plate (design choice in Actuator).
  axis_height = Actuator.axis_height
  // Material: 6061-T6 plate (no string/enum parameter exists to say so).
  mass = Al6061.density * thickness * width * height
}

/// Floating-end bearing housing.
model EndBlock {
  @emit(mid)
  seat_bore = bearing_seat.hole
  seat_depth = nominal(Bearing608.width) + 0.1mm
  back_wall = 5mm
  thickness = seat_depth + back_wall
  /// Journal passes the back wall through this clearance hole.
  through_bore = 10mm
  height = Actuator.axis_height + Bearing608.outer_diameter / 2 + back_wall
}

/// Plate bridging the two carriages and holding the nut.
model CarriagePlate {
  thickness = 6mm
  length = 80mm
  width = Actuator.rail_spacing + Mgn12hCarriage.width
  @emit(mid)
  nut_relief_bore = nut_relief.hole
  mass = Al6061.density * thickness * width * length

  // floor() and "+ 1" below are the fence-post count of rail mounting holes.
}

/// A rail cut to length from stock.
model RailCut {
  /// Needed length: travel, one carriage, an over-travel margin at each end.
  min_length = Actuator.travel + Mgn12hCarriage.length + 2 * Actuator.overtravel_margin
  length = round_to(min_length + Mgn12Rail.stock_step / 2, Mgn12Rail.stock_step)   // PROPOSED: ceil_to
  hole_count: Count = floor((length - 2 * Mgn12Rail.end_distance) / Mgn12Rail.hole_pitch) + 1   // PROPOSED: floor(); bare "+ 1" is Q001
}
