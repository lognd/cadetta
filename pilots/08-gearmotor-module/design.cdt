namespace acme.drive

use std.fasteners::{MetricThread, ScrewJoint, FastenerPolicy}
use std.materials::{Material, Materials}

// Shop policy for every ScrewJoint in this file (stdlib.md 4).
#![default(FastenerPolicy = AcmeShop)]

cite vendor_a  = "docs/vendor/gm37-a.pdf"
cite vendor_b  = "docs/vendor/gm42-b.pdf"
cite customer  = "docs/requirements.md"
cite rail_cert = "ASTM A276"

/// Acme shop standard: softer engagement rule for 6061, a fixed drill set.
ots AcmeShop: FastenerPolicy @"shop standard SS-104 rev C" {
  // PROPOSED: FastenerPolicy member names and shape are unspecified (stdlib.md 4 lists topics only); these are guesses
  engagement_factor_al6061 = 1.5
  bottom_clearance         = 0.5mm
  tap_lead_in              = 1.0mm
  drill_point_factor       = 0.3
  drill_set                = [2.5mm, 2.55mm, 3.3mm, 3.4mm, 4.2mm, 4.3mm, 5.5mm]
}

/// What the drive module needs from a gearmotor, whoever makes it.
interface GearMotor {
  shaft_dia: Length
  shaft_len: Length               // protrusion beyond the flange face
  pilot_dia: Length
  hole_pitch: Length              // square pattern, centre to centre
  mount_thread: MetricThread
  flange_thk: Length
  rated_torque >= 0.8N*m          // every implementer must meet this
  mass: Mass
  unit_cost: Money
  lead_time: Time
}

#[lifecycle(eol, "2027-03")]
ots Gm37A: GearMotor @vendor_a {
  shaft_dia    = 6mm [+0 -0.008mm]         @vendor_a:"p.3, shaft"
  shaft_len    = 32mm [+-0.5mm]            @vendor_a:"p.3, drawing"
  pilot_dia    = 12mm [-0.006mm -0.017mm]  @vendor_a:"p.3, pilot"
  hole_pitch   = 31mm                      @vendor_a:"p.3, drawing"
  mount_thread = M3
  flange_thk   = 3mm                       @vendor_a:"p.3, flange"
  rated_torque = 1.2N*m                    @vendor_a:"p.1"
  mass         = 210g
  unit_cost    = 24.50USD
  lead_time    = 1wk
}

#[lifecycle(active, "2026-10")]
ots Gm42B: GearMotor @vendor_b {
  shaft_dia    = 8mm [+0 -0.009mm]         @vendor_b:"p.4, shaft"
  shaft_len    = 34mm [+-0.5mm]            @vendor_b:"p.4, drawing"
  pilot_dia    = 16mm [-0.006mm -0.017mm]  @vendor_b:"p.4, pilot"
  hole_pitch   = 35mm                      @vendor_b:"p.4, drawing"
  mount_thread = M4
  flange_thk   = 4mm                       @vendor_b:"p.4, flange"
  rated_torque = 2.0N*m                    @vendor_b:"p.1"
  mass         = 380g
  unit_cost    = 31.00USD
  lead_time    = 5wk
}

/// Machined plate: motor bolts to one face, the plate bolts to the rail.
model MotorPlate(motor: GearMotor) {
  material  = Material::Al6061T6
  thickness = 10mm [+-0.1mm]                 @estimate:"stock 10mm plate, mill both faces"
  width     = 80mm
  height    = 60mm

  // PROPOSED: hole-class one-sided fit (`H7 on x` with x the vendor shaft/boss); spec lists only `p6 on x`
  fit pilot = H7 on motor.pilot_dia [0.005mm .. 0.05mm]
  #[emit(mid)]
  pilot_bore = pilot.hole                    // depends on the motor: 12 vs 16 mm
  mount_pitch = motor.hole_pitch             // alias of the vendor pitch

  mass      = Materials[material].density * (width * height * thickness)
  unit_cost = 38.00USD                       @estimate:"shop quote Q-2210"
  lead_time = 3wk                            @estimate:"shop quote Q-2210"
}

/// Wheel hub, bored to the motor shaft.
model WheelHub(motor: GearMotor) {
  width       = 8mm [+-0.1mm]
  tire_radius = 50mm
  // PROPOSED: same hole-class one-sided fit as above
  fit hub_seat = H7 on motor.shaft_dia [0mm .. 0.03mm]
  #[emit(mid)]
  bore        = hub_seat.hole                // depends on the motor: 6 vs 8 mm
  mass        = 25g                          @estimate:"CAD, 6061, 2026-10-01"
  unit_cost   = 9.00USD                      @estimate:"shop quote Q-2211"
  lead_time   = 2wk                          @estimate:"shop quote Q-2211"
}

/// 304 flat bar chassis rail section.
model ChassisRail {
  material  = Material::Ss304
  thickness = 10mm [+-0.15mm]                @rail_cert:"flat bar tolerance, assumed"
  mass      = 320g                           @estimate:"100 x 40 x 10, 8.0 g/cc"
  unit_cost = 14.00USD                       @estimate:"stockist list price"
  lead_time = 2wk                            @estimate:"stockist"
}

/// Per-motor wheel torque at the requirement slope and acceleration.
solver drive_torque @"analysis/drive_torque.py" {
  in  robot_mass = DriveModule.robot_mass, wheel_radius = DriveModule/hub.tire_radius
  out torque_per_motor: Torque
  variants per_alternate          // PROPOSED: robot_mass differs per alternate, so the cached result is stale under variant evaluation
}

assembly DriveModule {
  part motor: GearMotor = Gm37A alt [Gm42B]
  part plate: MotorPlate(motor = motor)
  part hub: WheelHub(motor = motor)
  part rail: ChassisRail

  // Motor to plate: tapped into 6061 (cut tap, 75% drill, shop engagement factor).
  part motor_screws[4]: ScrewJoint(thread = motor.mount_thread, clamp = motor.flange_thk,
                                   into = plate.material, depth_available = plate.thickness)
  // Plate to rail: counterbored in the plate, tapped into 304 (65% drill, factor 1.0).
  part rail_screws[4]: ScrewJoint(thread = M5, clamp = plate.thickness, into = rail.material,
                                  counterbore = true, depth_available = rail.thickness)

  // Wheel inner face to rail outer face. Flange sits on plate, plate on rail, hub flush with shaft end.
  let wheel_gap = motor.shaft_len - hub.width - plate.thickness - rail.thickness
  check gap_ok: 2mm <= wheel_gap <= 6mm "wheel clears the rail and does not rub"

  robot_mass = 10kg + 2 * module_mass        // frame and electronics 10kg, two modules
  module_mass = mass?(self)
  module_cost = sum?(self, unit_cost)
  module_lead = max?(self, lead_time)       // PROPOSED: max roll-up; only sum exists

  check torque_ok: motor.rated_torque >= 1.5 * drive_torque.torque_per_motor "1.5x margin on solver torque"
  require slope_torque: motor.rated_torque >= 1.5 * drive_torque.torque_per_motor @customer:"REQ-12 s3.2"
  require mass_budget: module_mass <= 0.95kg @customer:"REQ-14"
}
