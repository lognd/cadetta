// Round 3 (draft 1.2). Legacy input, not copied: ../05-solidworks-migration/legacy-equations.txt
// Cleaned form of the r2 import (imported.cdt is unchanged from r2 apart from `use` separators).
// Bindings: bindings/sw-equations.toml. Emitted file: emitted-equations.txt.
namespace acme.gearbox

use std.fasteners::{MetricThread, Iso273, Thread, Iso4762Head}

/// Gearbox cover plate, 6061-T6 plate stock.
model CoverPlate {
  length        = 120mm        was d1_sketch1 was Globals.plate_l
  width         = 80mm         @assumed:"bare 80 in legacy file, --assume-unit mm"   was d2_sketch1 was Globals.plate_w
  corner_radius = 5mm          was d3_sketch1 was Globals.corner_r
  bolt_pitch_x  = 100mm        was d4_sketch1 was Globals.bolt_spacing_x
  bolt_pitch_y  = 60mm         @assumed:"bare 60 in legacy file, --assume-unit mm"   was d5_sketch1 was Globals.bolt_spacing_y

  /// Clearance for the bolt's thread, medium class (6.6mm for M6, as the legacy "Dia").
  hole_dia      = Iso273[Bolt.thread].medium   was d6_sketch1 was Globals.dia

  /// Pilot bore. 12.012 in the legacy file was a hand-typed point inside H7
  /// (12.000..12.018); we declare the class and emit the midpoint 12.009.
  pilot_bore    = 12mm H7      was d7_sketch1 was Globals.pilot_bore   #[emit(mid)]

  /// Stock thickness, 1/4 in nominal. Legacy had it twice (6.35mm, 0.25in).
  thickness     = 0.25in       @"ASTM B209 6061-T6 plate, 1/4 in nominal" was d1_boss_extrude1 was Globals.plate_thk was Globals.plate_thickness

  cbore_dia     = Bolt.head_dia + 1mm   was d1_sketch2
  /// Counterbore depth, half the plate.
  cbore_depth   = thickness / 2         was d1_cut_extrude1
}

/// Gasket, same outline and hole pattern as the cover plate. Pure references are
/// aliases: they share the plate's source variable and (quantities.md 5.6) its emit point.
model Gasket {
  length        = CoverPlate.length          was d1_sketch1
  width         = CoverPlate.width           was d2_sketch1
  corner_radius = CoverPlate.corner_radius   was d3_sketch1
  bolt_pitch_x  = CoverPlate.bolt_pitch_x    was d4_sketch1
  bolt_pitch_y  = CoverPlate.bolt_pitch_y    was d5_sketch1
  hole_dia      = CoverPlate.hole_dia        was d6_sketch1
  pilot_bore    = CoverPlate.pilot_bore      was d7_sketch1
  thickness     = 1.5mm                      was d1_boss_extrude1 was Globals.gasket_thk
}

/// Cap screw as modeled in SOLIDWORKS: M6 socket head, dimensions from std tables.
model Bolt {
  thread       = MetricThread::M6
  shank_dia    = Thread[thread].major            was d1_sketch1 was Globals.bolt_dia_mm
  head_dia     = Iso4762Head[thread].head_dia    was d2_sketch1 was Globals.bolt_head_dia
  head_height  = Iso4762Head[thread].head_height was d1_boss_extrude1 was Globals.bolt_head_h

  /// 0.75in is not a standard M6 length (16, 20 mm); kept from legacy, review.
  length       = 0.75in                  was d1_boss_extrude2 was Globals.bolt_len_in

  /// Stack the screw passes through before it reaches the housing.
  let stack    = CoverPlate.thickness + Gasket.thickness
  /// Thread depth, legacy rule: length less plate and gasket (counterbore not credited).
  thread_depth = length - stack          was d1_sketch3
}

assembly GearboxCover {
  bolt_count: Count = 4                  was Globals.num_bolts

  part plate: CoverPlate
  part gasket: Gasket
  part bolt[bolt_count]: Bolt

  check cbore_clears_head for b in bolt: plate.cbore_dia > b.head_dia "counterbore must clear head"
  check hole_clears_shank for b in bolt: plate.hole_dia > b.shank_dia
  check thread_in_housing for b in bolt: b.thread_depth > 0mm "screw must reach the housing"
}
