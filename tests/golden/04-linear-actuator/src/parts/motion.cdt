// Off-the-shelf motion hardware, as families where the vendor sells a range.
// Materials and fasteners come from std; only vendor facts live here.

use std::materials::Material

cite steppero: datasheet {
  organization = "StepperOnline"
  title = "17HS16-2004S1 datasheet"
  pages = "1"
}
cite nema: standard {
  organization = "NEMA"
  number = "NEMA ICS 16"
  title = "Motion/position control motors, controls, and feedback devices"
  note = "Frame 17"
}
cite coupler: drawing {
  organization = "Misumi"
  title = "MCKN19-5-8 coupling drawing"
}
cite iso2904: standard {
  organization = "ISO"
  number = "ISO 2904:1977"
  title = "ISO metric trapezoidal screw threads: basic dimensions"
  date = "1977"
}
cite screwds: datasheet {
  title = "Generic T8 lead screw datasheet"
  note = "Verify revision"
}
cite nutds: drawing {
  title = "Generic T8 anti-backlash flange nut drawing"
}
cite hiwin: catalog {
  organization = "HIWIN"
  title = "MG series catalog, MGN12"
  note = "Verify revision"
}

/// What a drivetrain needs from a motor.
pub interface Stepper {
  holding_torque: Torque
  step_angle: Angle
}

/// What a drivetrain needs from a screw.
pub interface LeadScrew {
  pitch_diameter: Length
  flank_half_angle: Angle
  lead: Lead                              // Length/Angle, angle exponent -1
}

pub ots Nema17Motor: Stepper @steppero {
  face_width      = 42.3mm [+-0.2mm]     @nema
  body_length     = 40mm [+-1mm]
  hole_pitch      = 31mm [+-0.1mm]       @nema:"4 x M3 on a 31 mm square"
  thread_depth    = 4.5mm
  face_material   = Material::Steel1018  @assumed:"flange material not on datasheet; verify"
  pilot_diameter  = 22mm [+0 -0.05mm]    // drawing value, not an ISO 286 class
  pilot_height    = 2mm
  shaft_diameter  = 5mm [+0 -0.013mm]
  shaft_length    = 24mm                 // from flange face, includes D-flat
  holding_torque  = 0.45N*m
  step_angle      = 1.8deg
  rated_current   = 2A
  rotor_inertia   = 82g*cm^2
  mass            = 0.28kg
  unit_cost       = 14.50USD
  lead_time       = 2wk
  moq: Count      = 1
  supplier        = "StepperOnline"

  // Origin is the rear of the body; the flange face the plate bolts to is body_length up.
  datum face = origin.offset(z = body_length)
  mount_holes: [Point2 on face; 4] = rect_pattern(2, 2, hole_pitch, hole_pitch)
}

pub ots FlexCoupler @coupler {
  outer_diameter           = 19mm
  length                   = 25mm
  bore_motor_side          = 5mm H7
  bore_screw_side          = 8mm H7
  bore_depth               = 10mm        // per side
  rated_torque             = 1.2N*m
  max_speed                = 6000rpm
  max_angular_misalignment = 5deg
  unit_cost                = 3.20USD
  lead_time                = 1wk
  moq: Count               = 1
  supplier                 = "Misumi"
}

pub enum TrThread { Tr8P2, Tr10P2 }

table Iso2904 @iso2904 {
  key thread: TrThread
  cols major: Length, pitch: Length, pitch_diameter: Length
  Tr8P2  => 8mm,  2mm, 7mm
  Tr10P2 => 10mm, 2mm, 9mm
}

/// Trapezoidal lead screw cut to `length`; `starts` turns pitch into lead.
pub ots TrScrew(thread: TrThread, starts: Count, length: Length): LeadScrew @screwds {
  major_diameter   = Iso2904[thread].major
  pitch            = Iso2904[thread].pitch
  pitch_diameter   = Iso2904[thread].pitch_diameter
  lead: Lead       = pitch * starts / 1rev       // 2 mm * 4 / rev = 8mm/rev
  flank_half_angle = 15deg
  cut_increment    = 5mm                         // vendor cuts to the next 5 mm
  unit_cost        = 9.00USD
  lead_time        = 2wk
  moq: Count       = 1
  supplier         = "generic T8 vendor"
}

pub ots BrassNut @nutds {
  length               = 24mm
  body_diameter        = 10mm
  flange_diameter      = 22mm
  flange_thickness     = 3.5mm
  bolt_circle_diameter = 16mm
  mount_hole_diameter  = 3.4mm
  mount_hole_count: Count = 4
  mass                 = 25g
  unit_cost            = 6.80USD
  lead_time            = 3wk
  moq: Count           = 1
  supplier             = "generic T8 vendor"
}

/// MGN12 rail cut to `length` from stock.
pub ots Mgn12Rail(length: Length) @hiwin {
  width                = 12mm
  height               = 8mm
  hole_pitch           = 25mm
  end_distance         = 10mm
  stock_step           = 50mm              // rails are cut from stock in 50 mm steps
  mount_hole_diameter  = 3.5mm
  counterbore_diameter = 6mm
  counterbore_depth    = 4.5mm
  hole_count: Count    = floor((length - 2 * end_distance) / hole_pitch) + 1
  unit_cost            = 12.00USD
  lead_time            = 4wk
  moq: Count           = 1
  supplier             = "HIWIN distributor"
}

pub ots Mgn12hCarriage @hiwin {
  total_height        = 13mm
  width               = 27mm
  length              = 45.4mm
  hole_spacing_across = 20mm
  hole_spacing_along  = 20mm
  dynamic_load        = 3.43kN
  static_load         = 5.15kN
  mass                = 90g
  unit_cost           = 9.60USD
  lead_time           = 3wk
  moq: Count          = 1
  supplier            = "HIWIN distributor"
}
