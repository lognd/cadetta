
use std::commercial::Sourced
use std::retaining::Din472

// Off-the-shelf parts for the bearing housing. Bearing values are
// transcribed from the catalog; verify against the current SKF General
// Catalogue before any release. Circlip sizes come from std::retaining.

cite skf: catalog {
  organization = "SKF"
  title = "608-2RS1 deep groove ball bearing"
  url = "https://www.skf.com/catalogue/608-2RS1"
  edition = "2024"
  accessed = "2026-10-13"
}
use std::din472

/// SKF 608-2RS1 deep-groove ball bearing, 8 x 22 x 7 mm, contact seals.
/// Deviations are ISO 492 Normal class (individual ring deviations).
pub ots Skf608: Sourced @skf {
  bore      = 8mm [+0 -0.008mm]       @skf:"product table, d tolerance"   #[role(hole)]
  outer_dia = 22mm [+0 -0.009mm]      @skf:"product table, D tolerance"   #[role(shaft)]
  width     = 7mm [+0 -0.12mm]        @skf:"product table, B tolerance"

  /// Abutment limits from the dimension table: requirements on the mating parts.
  shaft_abutment_dia   >= 10mm        @skf:"d_a min"
  housing_abutment_dia <= 20mm        @skf:"D_a max"
  inner_ring_land_dia  = 12.6mm       @skf:"d1 approx"
  corner_radius_min    = 0.3mm        @skf:"r_s min"

  /// Radial internal clearance, Normal group, 6 < d <= 10 (ISO 5753).
  radial_clearance in 2um..13um       @skf:"C0 Normal"

  dynamic_load_rating = 3.45kN        @skf:"product table, C"
  static_load_rating  = 1.37kN        @skf:"product table, C0"
  mass                = 0.012kg       @skf:"product table"   // std::commercial::Sourced
}

/// DIN 472 internal circlip for a 22 mm bore: ring and recommended groove.
/// Sizes are table lookups; groove_dia and groove_width carry their tolerance
/// classes from the table, the ring thickness deviation is written here.
pub ots Din472Circlip22 @din472 {
  bore_nominal = 22mm
  thickness    = Din472[bore_nominal].ring_thickness [+0 -0.06mm]
  groove_dia   = Din472[bore_nominal].groove_dia
  groove_width = Din472[bore_nominal].groove_width
  groove_edge_dist >= Din472[bore_nominal].edge_margin   @din472:"n min, groove edge to housing face"
}
