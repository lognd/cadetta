{
  "spec": "1.4",
  "doc": "bindings",
  "section": "bindings.md 3.4",
  "rule": "adapter-stdout-protocol",
  "kind": "binding",
  "entry": "python",
  "note": "logs go to stderr only; a stray stdout line corrupts JSON-RPC",
  "must_fire": {
    "diagnostics": [],
    "result": "value",
    "stdout_all_json_rpc": false
  },
  "must_not_fire": {
    "diagnostics": [],
    "result": "value",
    "stdout_all_json_rpc": true
  }
}
