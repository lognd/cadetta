{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "note-text-citation-only",
  "kind": "source",
  "entry": "emit json",
  "note": "a Text param has a note under the same rules; only a citation can appear in it",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"anodize\"",
          "\"note\": \"@\\\"MIL-A-8625\\\"\""
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "anodize"
        ],
        "excludes": [
          "MIL-A-8625"
        ]
      }
    }
  }
}
