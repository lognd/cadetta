{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "serialisation-indent",
  "kind": "source",
  "entry": "emit json",
  "note": "2-space indent, no tabs",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "{\n  \"schema\": \"cadetta.params/1\",\n  \"header\": {\n    \"adapter\": \"json 0.1.0\""
        ],
        "excludes": [
          "\t",
          "\n   \"",
          "{\"schema\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\n  \"params\": [\n    {\n      \"name\": \"W\""
        ],
        "excludes": [
          "\t",
          "    \"schema\""
        ]
      }
    }
  }
}
