{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "value-string",
  "kind": "source",
  "entry": "emit json",
  "note": "value is a decimal string, never a JSON number",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"10\""
        ],
        "excludes": [
          "\"value\": 10",
          "\"value\": 10.0"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"10\"",
          "\"unit\": \"mm\""
        ],
        "excludes": [
          "\"value\": 10,",
          "\"value\": 10\n"
        ]
      }
    }
  }
}
