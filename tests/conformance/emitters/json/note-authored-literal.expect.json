{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "note-literal",
  "kind": "source",
  "entry": "emit json",
  "note": "note carries the authored literal when its source text differs from the written value's text",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"6.35\"",
          "\"note\": \"1/4in\""
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"5\""
        ],
        "excludes": [
          "\"note\""
        ]
      }
    }
  }
}
