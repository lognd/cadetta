{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "note-emit-point",
  "kind": "source",
  "entry": "emit json",
  "note": "note carries emit=POINT when the emit point is not nominal, and not otherwise",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"note\": \"12mm H7 emit=mmc\""
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"note\": \"12mm H7\""
        ],
        "excludes": [
          "emit="
        ]
      }
    }
  }
}
