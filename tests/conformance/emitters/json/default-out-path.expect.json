{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md (intro)",
  "rule": "default-out",
  "kind": "source",
  "entry": "emit json",
  "note": "with no out key the file is build/json.json (build/<id>.json, id = adapter name); with one, that path",
  "must_fire": {
    "diagnostics": [],
