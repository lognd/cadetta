{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "R015",
  "kind": "source",
  "entry": "emit json",
  "note": "a dimension locator that the adapter paths filter excludes is not emitted and so not reported",
  "must_fire": {
    "diagnostics": [
      {
        "code": "R015",
        "severity": "error"
      }
    ],
    "exit": 1
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "Depth"
        ],
        "excludes": [
          "D1@Sk",
          "Width"
        ]
      }
    }
  }
}
