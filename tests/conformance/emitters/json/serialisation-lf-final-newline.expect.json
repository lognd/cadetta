{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "serialisation-eol",
  "kind": "source",
  "entry": "emit json",
  "note": "LF line endings and a final newline",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [],
        "excludes": [
          "\r"
        ],
        "ends_with": "}\n"
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [],
        "excludes": [
          "\r\n",
          "}\n\n"
        ],
        "ends_with": "}\n"
      }
    }
  }
}
