{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "name-mangled",
  "kind": "source",
  "entry": "emit json",
  "note": "a path with no bound name is named by its mangled path (adapters.md 3.1): __ for dots and slashes, [i] as _i, a [*] segment dropped",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"name\": \"Rover__axle_1__end_diameter\""
        ],
        "excludes": [
          "\"name\": \"Rover.axle",
          "\"name\": \"Rover/axle",
          "\"name\": \"Rover__axle[1]"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"name\": \"Rover__axle__end_diameter\""
        ],
        "excludes": [
          "\"name\": \"Rover__axle_1__end_diameter\"",
          "[*]"
        ]
      }
    }
  }
}
