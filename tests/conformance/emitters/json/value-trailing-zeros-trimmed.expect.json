{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "value-precision",
  "kind": "source",
  "entry": "emit json",
  "note": "default precision is 6 decimals; zeros and a bare decimal point are trimmed, so 12.5 is not 12.500000 and 10 is not 10.0",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"12.5\""
        ],
        "excludes": [
          "12.500000",
          "\"12.50\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"10\""
        ],
        "excludes": [
          "\"10.0\"",
          "10.000000"
        ]
      }
    }
  }
}
