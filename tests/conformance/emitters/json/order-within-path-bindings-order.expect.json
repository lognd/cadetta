{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 2",
  "rule": "order-locators",
  "kind": "source",
  "entry": "emit json",
  "note": "within one path, locators appear in bindings-file order",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [],
        "excludes": [],
        "order": [
          "\"name\": \"W2\"",
          "\"name\": \"W1\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [],
        "excludes": [],
        "order": [
          "\"name\": \"W1\"",
          "\"name\": \"W2\""
        ]
      }
    }
  }
}
