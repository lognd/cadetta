{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "value-native-unit",
  "kind": "source",
  "entry": "emit json",
  "note": "value and unit are in the locator's native_unit",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"1\"",
          "\"unit\": \"in\""
        ],
        "excludes": [
          "\"value\": \"25.4\"",
          "\"unit\": \"mm\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"value\": \"25.4\"",
          "\"unit\": \"mm\""
        ],
        "excludes": [
          "\"unit\": \"in\""
        ]
      }
    }
  }
}
