{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "key-order",
  "kind": "source",
  "entry": "emit json",
  "note": "each param has keys in the order name, path, value, unit, note",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [],
        "excludes": [],
        "order": [
          "\"name\"",
          "\"path\"",
          "\"value\"",
          "\"unit\"",
          "\"note\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [],
        "excludes": [],
        "order": [
          "\"name\"",
          "\"path\"",
          "\"value\"",
          "\"unit\""
        ]
      }
    }
  }
}
