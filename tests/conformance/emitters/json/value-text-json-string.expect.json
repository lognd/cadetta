{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "value-text",
  "kind": "source",
  "entry": "emit json",
  "note": "Text is a JSON string with unit omitted (unlike sw-equations, which does not emit it)",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"name\": \"Note\"",
          "\"value\": \"anodize\""
        ],
        "excludes": [
          "\"unit\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"name\": \"W\""
        ],
        "excludes": [
          "\"name\": \"Note\"",
          "anodize"
        ]
      }
    }
  }
}
