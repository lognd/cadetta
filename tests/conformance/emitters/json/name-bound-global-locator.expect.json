{
  "spec": "1.4",
  "doc": "emitters/json",
  "section": "emitters/json.md 1",
  "rule": "name-bound",
  "kind": "source",
  "entry": "emit json",
  "note": "name is the bound locator of a global locator",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"name\": \"Plate_Thk\"",
          "\"path\": \"acme.demo::Part.width\""
        ],
        "excludes": [
          "\"name\": \"Part__width\"",
          "\"name\": \"Part.width\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.json": {
        "contains": [
          "\"name\": \"Part__width\""
        ],
        "excludes": [
          "\"name\": \"Plate_Thk\""
        ]
      }
    }
  }
}
