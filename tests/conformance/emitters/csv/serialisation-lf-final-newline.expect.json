{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "serialisation-eol",
  "kind": "source",
  "entry": "emit csv",
  "note": "LF line endings and exactly one final newline",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [],
        "excludes": [
          "\r"
        ],
        "ends_with": "mm,\n"
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [],
        "excludes": [
          "\r\n",
          "mm,\n\n"
        ],
        "ends_with": "mm,\n"
      }
    }
  }
}
