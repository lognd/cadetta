{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "note-literal-fit",
  "kind": "source",
  "entry": "emit csv",
  "note": "note carries the tolerance or class of the authored literal (12mm H7) while value is the emit point",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nPilotBore,12.009,mm,12mm H7 emit=mid\n"
        ],
        "excludes": [
          "; ",
          "emit mid"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nPilotBore,12,mm,12mm H7\n"
        ],
        "excludes": [
          "emit=",
          "; "
        ]
      }
    }
  }
}
