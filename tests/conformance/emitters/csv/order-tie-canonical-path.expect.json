{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 2",
  "rule": "order-tie",
  "kind": "source",
  "entry": "emit csv",
  "note": "independent paths are ordered by canonical path (byte order), whatever order the bindings file lists them in",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [],
        "excludes": [],
        "order": [
          "\nZ1,",
          "\nZ2,"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nZ1,",
          "\nZ2,"
        ],
        "excludes": [],
        "order_not": [
          "\nZ2,",
          "\nZ1,"
        ]
      }
    }
  }
}
