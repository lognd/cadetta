{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 2",
  "rule": "order-locators",
  "kind": "source",
  "entry": "emit csv",
  "note": "within one path, locators appear in bindings-file order",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [],
        "excludes": [],
        "order": [
          "\nW2,",
          "\nW1,"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [],
        "excludes": [],
        "order": [
          "\nW1,",
          "\nW2,"
        ]
      }
    }
  }
}
