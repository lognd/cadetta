{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 3",
  "rule": "read-native-unit",
  "kind": "binding",
  "entry": "read",
  "note": "a row with an empty unit takes the locator's native_unit (unit_assumed recorded)",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "observed": {
      "B": {
        "value": "5mm",
        "unit_assumed": "mm"
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "observed": {
      "B": {
        "value": "5in"
      }
    }
  }
}
