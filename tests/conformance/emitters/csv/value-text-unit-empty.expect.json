{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "value-text",
  "kind": "source",
  "entry": "emit csv",
  "note": "Text is emitted as its string with the unit column empty (unlike sw-equations, which does not emit it)",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nNote,anodize,,\n"
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nW,10,mm,\n"
        ],
        "excludes": [
          "Note",
          "anodize"
        ]
      }
    }
  }
}
