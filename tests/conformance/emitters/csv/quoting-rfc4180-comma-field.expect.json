{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "quoting-comma",
  "kind": "source",
  "entry": "emit csv",
  "note": "RFC 4180: a field containing a comma is quoted; a field without one is not",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nNote,\"a,b\",,\n"
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nNote,ab,,\n"
        ],
        "excludes": [
          "\""
        ]
      }
    }
  }
}
