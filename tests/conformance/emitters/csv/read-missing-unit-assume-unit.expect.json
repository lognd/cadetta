{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 3",
  "rule": "read-assume-unit",
  "kind": "binding",
  "entry": "read",
  "note": "--assume-unit supplies the unit of a unitless row",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "observed": {
      "B": {
        "value": "5in",
        "unit_assumed": "in"
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "observed": {
      "B": {
        "value": "5mm",
        "unit_assumed": "mm"
      }
    }
  }
}
