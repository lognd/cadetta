{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "Q004",
  "kind": "source",
  "entry": "emit csv",
  "note": "with [[adapter]] precision = 2, 0.125mm is not representable: Q004, never rounded",
  "must_fire": {
    "diagnostics": [
      {
        "code": "Q004",
        "severity": "error"
      }
    ],
    "exit": 1
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nW,0.12,mm,"
        ],
        "excludes": []
      }
    }
  }
}
