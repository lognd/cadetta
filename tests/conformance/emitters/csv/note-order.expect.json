{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "note-order",
  "kind": "source",
  "entry": "emit csv",
  "note": "note order is authored literal, emit=POINT, citation, separated by single spaces",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "1/4in emit=mid @\"\"ASTM B209\"\"\""
        ],
        "excludes": [
          "emit=mid 1/4in",
          "@\"\"ASTM B209\"\" emit=",
          "; "
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "1/4in @\"\"ASTM B209\"\"\""
        ],
        "excludes": [
          "emit=",
          "; "
        ]
      }
    }
  }
}
