{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "quoting-quote",
  "kind": "source",
  "entry": "emit csv",
  "note": "RFC 4180: a field containing a double quote is quoted and each inner quote doubled",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\"\"ASTM B209\"\""
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "1/4in"
        ],
        "excludes": [
          "\"\""
        ]
      }
    }
  }
}
