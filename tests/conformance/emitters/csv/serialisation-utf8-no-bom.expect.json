{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "serialisation-bom",
  "kind": "source",
  "entry": "emit csv",
  "note": "UTF-8 without a BOM: the file begins with the header comment's #, not U+FEFF",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "# cadetta emit csv"
        ],
        "excludes": [
          "\ufeff",
          "\u00ef\u00bb\u00bf"
        ],
        "order": [
          "# cadetta emit csv",
          "name,value,unit,note"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "# cadetta emit csv"
        ],
        "excludes": [
          "\ufeff",
          "\u00ef\u00bb\u00bf"
        ]
      }
    }
  }
}
