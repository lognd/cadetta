{
  "spec": "1.4",
  "doc": "emitters/csv",
  "section": "emitters/csv.md 1",
  "rule": "value-bare",
  "kind": "source",
  "entry": "emit csv",
  "note": "Counts and Ratios are plain decimals with the unit column empty; a Length keeps its unit",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nNumBolts,4,,\n",
          "\nRatio,0.5,,\n"
        ],
        "excludes": [
          "NumBolts,4,mm",
          "\"4\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/params.csv": {
        "contains": [
          "\nNumBolts,4,mm,\n"
        ],
        "excludes": [
          "NumBolts,4,,"
        ]
      }
    }
  }
}
