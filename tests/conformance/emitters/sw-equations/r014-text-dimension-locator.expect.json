{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "R014",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "R014 applies to any locator kind: a Text parameter bound to a dimension is also an error when emitted",
  "must_fire": {
    "diagnostics": [
      {
        "code": "R014",
        "severity": "error"
      }
    ],
    "exit": 1
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"W\" = 10mm"
        ],
        "excludes": [
          "\"Note\"",
          "anodize"
        ]
      }
    }
  }
}
