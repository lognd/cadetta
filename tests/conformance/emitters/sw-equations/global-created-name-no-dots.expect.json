{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "created-name",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "a ref-mode dimension with no bound global makes the emitter create one; the created name is mangled, never dotted",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Gasket__width\" = 10mm",
          "\"D1@Sk@Plate.SLDPRT\" = \"Gasket__width\""
        ],
        "excludes": [
          "\"Gasket.width\"",
          "\"acme.demo"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Gasket__width\" = 10mm"
        ],
        "excludes": [
          "\"Gasket.width\""
        ]
      }
    }
  }
}
