{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "bare-values",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"NumBolts\" = 4",
          "\"Ratio\" = 0.5"
        ],
        "excludes": [
          "4mm",
          "0.5mm"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"NumBolts\" = 4mm",
          "\"Ratio\" = 0.5"
        ],
        "excludes": [
          "\"NumBolts\" = 4\n"
        ]
      }
    }
  }
}
