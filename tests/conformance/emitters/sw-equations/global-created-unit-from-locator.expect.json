{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "created-global-unit",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "the created global takes the dimension locator's native_unit, else the adapter's declared native unit",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Gasket__width\" = 1in",
          "\"D1@Sk@Plate.SLDPRT\" = \"Gasket__width\""
        ],
        "excludes": [
          "= 25.4mm"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Gasket__width\" = 25.4mm"
        ],
        "excludes": [
          "1in"
        ]
      }
    }
  }
}
