{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "trailing-order",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "order is literal, emit point, citation; emit= is absent when the point is nominal",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "' 1/4in emit=mid @\"ASTM B209\""
        ],
        "excludes": [
          "@\"ASTM B209\" emit=",
          "emit=mid 1/4in"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "' 1/4in @\"ASTM B209\""
        ],
        "excludes": [
          "emit="
        ]
      }
    }
  }
}
