{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "header",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "the header is line 1; a second header line never appears",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "' cadetta emit sw-equations 0.1.0 ir=blake3:",
          "bindings=blake3:"
        ],
        "excludes": []
      }
    },
    "order": [
      "' cadetta emit",
      "\"W\""
    ]
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"W\" = 10mm"
        ],
        "excludes": [
          "' cadetta emit sw-equations 0.1.0 ir=blake3:\n' cadetta"
        ]
      }
    }
  }
}
