{
  "spec": "1.4",
  "doc": "emitters/sw-equations",
  "section": "emitters/sw-equations.md 1",
  "rule": "trailing-emit-point",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "emit=mmc"
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"B\" = 12mm"
        ],
        "excludes": [
          "emit="
        ]
      }
    }
  }
}
