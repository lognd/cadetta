model Lid {
  holes: [Point2 on origin; 2] = rect_pattern(2, 1, 31mm, 0mm)
}

model Base {
  datum top = origin.offset(z = 10mm)
  tapped: [Point2 on origin; 2] = rect_pattern(2, 1, 30mm, 0mm)
}

assembly Box {
  part lid: Lid
  part base: Base
  place base.origin at origin
  place lid.origin at base.top
  check al: aligned(lid.holes, base.tapped, 0.1mm) "holes line up"
}
