use std::fasteners::ScrewJoint
use std::materials::Material

model Rail {
  height = 30mm
  material = Material::Al6061T6
  datum top = origin.offset(z = height)
  datum site = top.offset(x = 40mm)
  tapped: [Point2 on site; 2] = [Point2(-25mm, 0mm), Point2(25mm, 0mm)] [+-0.05mm]
}

model Bracket {
  thickness = 6mm
  datum base = origin
  holes: [Point2 on base; 2] = [Point2(-24.5mm, 0mm), Point2(25mm, 0mm)] [+-0.05mm]
}

assembly Mount {
  part rail: Rail
  part bracket: Bracket
  place rail.origin at origin
  place bracket.base at rail.site
  part screws: ScrewJoint(thread = M5, clamp = bracket.thickness, into = rail.material, at = bracket.holes, onto = rail.tapped)
}
