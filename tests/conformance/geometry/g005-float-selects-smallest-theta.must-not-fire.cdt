use std::fasteners::ScrewJoint
use std::materials::Material

model Lid {
  thickness = 3mm
  holes: [Point2 on origin; 2] = rect_pattern(2, 1, 30mm, 0mm)
  wide: [Point2 on origin; 2] = rect_pattern(2, 1, 200mm, 0mm)
  datum edge = origin.offset(x = 400mm)
}

model Base {
  material = Material::Al6061T6
  datum top = origin.offset(z = 10mm)
  tapped: [Point2 on origin; 2] = rect_pattern(2, 1, 30mm, 0mm)
  wide_tapped: [Point2 on origin; 2] = rect_pattern(2, 1, 200mm, 0mm)
  datum edge = origin.offset(x = 400mm)
}

assembly Box {
  part lid: Lid
  part base: Base
  place base.origin at origin
  place lid.origin at base.top
  part j: ScrewJoint(thread = M4, clamp = lid.thickness, into = base.material, at = lid.holes, onto = base.tapped)
  part k: ScrewJoint(thread = M4, clamp = lid.thickness, into = base.material, at = lid.wide, onto = base.wide_tapped)
  check lid_edge: (lid.edge in origin).y - (base.edge in origin).y <= 3mm "lid edge flush"
}
