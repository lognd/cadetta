model Foot {
  datum top = origin
}

model Base {
  datum underside = origin
  foot_sites: [Point2 on underside; 3] = rect_pattern(3, 1, 20mm, 0mm)
}

assembly Frame {
  part base: Base
  part feet[3]: Foot
  place base.origin on origin
  place feet[i].top on base.underside.at(base.foot_sites[i]) for i in 0..2
  
}
