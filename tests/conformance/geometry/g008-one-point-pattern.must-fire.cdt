use std::fasteners::ScrewJoint
use std::materials::Material

model Lid {
  thickness = 3mm
  holes: [Point2 on origin; 1] = rect_pattern(1, 1, 30mm, 0mm)
  datum edge = origin.offset(x = 50mm)
}

model Base {
  material = Material::Al6061T6
  datum top = origin.offset(z = 10mm)
  tapped: [Point2 on origin; 1] = rect_pattern(1, 1, 30mm, 0mm)
  datum edge = origin.offset(x = 50mm)
}

assembly Box {
  part lid: Lid
  part base: Base
  place base.origin at origin
  place lid.origin at base.top
  part j: ScrewJoint(thread = M4, clamp = lid.thickness, into = base.material, at = lid.holes, onto = base.tapped)
  check lid_edge: (lid.edge in origin).x - (base.edge in origin).x <= 0.1mm "lid edge flush"
}
