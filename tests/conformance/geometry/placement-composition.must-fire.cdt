model Rail {
  height = 30mm
  datum top = origin.offset(z = height)
  datum site = top.offset(x = 40mm)
}

model Bracket {
  datum base = origin
  holes: [Point2 on base; 2] = [Point2(-25mm, 0mm), Point2(25mm, 0mm)]
}

assembly Mount {
  part rail: Rail
  part bracket: Bracket
  place rail.origin at origin
  place bracket.base at rail.site
  hx = (bracket.holes[0] in origin).x
  hz = (bracket.holes[0] in origin).z
}
