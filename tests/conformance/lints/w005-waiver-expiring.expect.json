{
  "spec": "1.4",
  "doc": "lints",
  "section": "lints.md 3",
  "rule": "W005",
  "kind": "source",
  "entry": "check",
  "must_fire": {
    "diagnostics": [
      {
        "code": "W005",
        "severity": "info"
      },
      {
        "code": "C001",
        "severity": "error"
      }
    ],
    "exit": 0
  },
  "must_not_fire": {
    "diagnostics": [
      {
        "code": "C001",
        "severity": "error"
      }
    ],
    "exit": 0
  },
  "note": "an expiring waiver still suppresses C001 (lints.md 2.1; the waived diagnostic stays in the run), so W005 fires and the run exits 0; contrast w001"
}
