cite src: web {
  title = "Source page"
  url = "https://x.example/a.pdf"
  accessed = "2026-10-13"
}
pub interface Caster {
  diameter: Length
  load_rating >= 400N
}
pub ots Good: Caster @src {
  diameter = 5in
  load_rating = 500N
}
pub ots Bad: Caster @src {
  diameter = 5in
  load_rating = 450N
}
pub assembly Rover {
  part wheel[4]: Caster = Good alt [Bad]
  check load_ok: wheel.load_rating >= 440N
}
