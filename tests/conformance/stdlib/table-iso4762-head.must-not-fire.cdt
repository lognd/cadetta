use std::fasteners::{MetricThread, Thread, Iso273, TapDrill, Iso4762Head, Iso4762Len, Iso4032}
model P {
  head_dia = Iso4762Head[MetricThread::M6].head_dia
  socket = Iso4762Head[MetricThread::M6].socket
  height_min = Iso4762Head[MetricThread::M6].head_height.max
  counterbore_depth = Iso4762Head[MetricThread::M6].counterbore_depth
}
