{
  "spec": "1.4",
  "doc": "quantities",
  "section": "quantities.md 5.5",
  "rule": "round-ties-away-from-zero",
  "kind": "source",
  "entry": "eval",
  "must_fire": {
    "diagnostics": [],
    "values": [
      {
        "path": "acme.demo::P.a",
        "nominal": "1mm"
      },
      {
        "path": "acme.demo::P.b",
        "nominal": "-1mm"
      }
    ]
  },
  "must_not_fire": {
    "diagnostics": [],
    "values": [
      {
        "path": "acme.demo::P.a",
        "nominal": "0mm"
      },
      {
        "path": "acme.demo::P.b",
        "nominal": "-1mm"
      }
    ]
  }
}
