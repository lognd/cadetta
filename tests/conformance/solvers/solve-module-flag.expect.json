{
  "spec": "1.4",
  "doc": "solvers",
  "section": "solvers.md 4",
  "rule": "solve-module",
  "kind": "source",
  "entry": "solve",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "analysis/a.out.json": {
        "exists": true
      },
      "analysis/b.out.json": {
        "exists": false
      }
    },
    "args": [
      "--module",
      "src/a.cdt"
    ]
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "analysis/a.out.json": {
        "exists": false
      },
      "analysis/b.out.json": {
        "exists": false
      }
    },
    "args": [
      "--module",
      "src/none.cdt"
    ]
  }
}
