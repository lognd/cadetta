model Frame {
  span = 300mm
}
solver sizing {
  script "analysis/sizing.py"
  in span = Frame.span
  in a = 2mm, b = Frame.span, c = -Frame.span, d = Frame.span + 1mm,
     e = 2 * Frame.span, f = Frame.span / 2, g = Frame.span ^ 2,
     h = max(Frame.span, 1mm), i = Frame.span as mm, j = 300mm [+-0.5mm]
  out wall: Length
}
