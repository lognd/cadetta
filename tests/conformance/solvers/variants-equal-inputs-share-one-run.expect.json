{
  "spec": "1.4",
  "doc": "solvers",
  "section": "solvers.md 4.1",
  "rule": "solve-variants",
  "kind": "source",
  "entry": "solve",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "analysis/sizing.out.json": {
        "contains": [
          "\"variant\": \"acme.demo::Rover/wheel=acme.demo::Heavy\"",
          "\"variant\": \"acme.demo::Rover/wheel=acme.demo::Heavy2\""
        ]
      }
    },
    "runs": 2,
    "args": [
      "--variants"
    ]
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "analysis/sizing.out.json": {
        "contains": [
          "\"variant\": \"acme.demo::Rover/wheel=acme.demo::Heavy\""
        ]
      }
    },
    "runs": 2,
    "args": [
      "--variants"
    ]
  }
}
