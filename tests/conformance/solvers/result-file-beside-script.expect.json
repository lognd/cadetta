{
  "spec": "1.4",
  "doc": "solvers",
  "section": "solvers.md 4",
  "rule": "result-file",
  "kind": "source",
  "entry": "solve",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "analysis/wall_sizing.out.json": {
        "contains": [
          "\"schema\": \"cadetta.solve-result/1\"",
          "\"solver\": \"acme.demo::Frame.wall_sizing\"",
          "\"input_digest\": \"blake3:",
          "\"script_digest\": \"blake3:",
          "\"dep_digests\"",
          "\"inputs\"",
          "\"outputs\"",
          "\"diagnostics\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [
      {
        "code": "S005",
        "severity": "error"
      }
    ],
    "exit": 1,
    "output": {
      "analysis/wall_sizing.out.json": {
        "exists": false
      }
    }
  }
}
