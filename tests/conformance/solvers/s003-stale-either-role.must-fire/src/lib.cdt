model Frame {
  wall = 3mm
  span = 300mm
  max_load = 1300N
  solver wall_sizing {
    script "analysis/wall_sizing.sh"
    in  load = max_load, span = span
    out min_wall: Length
    deps "analysis/material_db.csv"
  }
  derived = wall_sizing.min_wall * 2
  check derived_ok: derived >= 1mm "derived from the solver output"
}
