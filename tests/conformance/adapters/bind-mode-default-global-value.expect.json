{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3",
  "rule": "mode-defaults",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"W\" = 10mm"
        ],
        "excludes": [
          "\"Part__width\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"W\""
        ],
        "excludes": []
      }
    }
  }
}
