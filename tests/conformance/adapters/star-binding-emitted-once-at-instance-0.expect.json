{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3",
  "rule": "star-binding",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "exactly one line for L in the fire case",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"L\" = 10mm"
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"L1\" = 10mm"
        ],
        "excludes": [
          "\"L\""
        ]
      }
    }
  }
}
