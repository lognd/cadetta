{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 5",
  "rule": "sync-order",
  "kind": "binding",
  "entry": "protocol",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "sent": [
      "initialize",
      "open",
      "push:a",
      "push:b",
      "save",
      "close",
      "shutdown"
