{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3.2",
  "rule": "modules-scope",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"GW\""
        ],
        "excludes": [
          "\"GBW\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"GBW\""
        ],
        "excludes": [
          "\"GW\""
        ]
      }
    }
  }
}
