      "\"D@S@P.SLDPRT\""
    ]
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"W\" = 10mm"
        ],
        "excludes": []
      }
    }
  }
}
