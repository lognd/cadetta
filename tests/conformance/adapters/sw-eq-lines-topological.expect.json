{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3a",
  "rule": "line-order",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
