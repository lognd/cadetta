{
  "spec": "1.5",
  "doc": "adapters",
  "section": "adapters.md 3.6",
  "rule": "tolerance-drive",
  "kind": "binding",
  "entry": "push-plan",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "contains": [
        "tolerance symmetric +-0.1mm",
        "tolerance bilateral +0.2mm/-0.1mm",
