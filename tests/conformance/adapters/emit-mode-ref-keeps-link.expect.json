{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 5",
  "rule": "mode-ref",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"D@S@P.SLDPRT\" = \"W\""
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"D@S@P.SLDPRT\" = 10mm"
        ],
        "excludes": []
      }
    }
  }
}
