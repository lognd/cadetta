{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 2.3",
  "rule": "restore-failure",
  "kind": "binding",
  "entry": "sync",
  "must_fire": {
    "diagnostics": [
      {
        "code": "R004",
        "severity": "error"
      }
    ],
    "exit": 1,
    "message_contains": [
      "restore failed"
    ]
  },
  "must_not_fire": {
    "diagnostics": [
      {
        "code": "R004",
        "severity": "error"
      }
    ],
    "exit": 1,
    "message_contains": [],
    "message_excludes": [
      "restore failed"
    ]
  }
}
