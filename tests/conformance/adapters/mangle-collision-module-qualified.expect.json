{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3.1",
  "rule": "mangling",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"a__Part__width\"",
          "\"b__Part__width\""
        ],
        "excludes": [
          "\"Part__width\""
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Part__width\"",
          "\"Other__width\""
        ],
        "excludes": []
      }
    }
  }
}
