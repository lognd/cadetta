{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3",
  "rule": "ref_to",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"D1@Sk@Plate.SLDPRT\" = \"W1\""
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"D1@Sk@Plate.SLDPRT\" = \"W2\""
        ],
        "excludes": []
      }
    }
  }
}
