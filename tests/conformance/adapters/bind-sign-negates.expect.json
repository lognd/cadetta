{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3.4",
  "rule": "sign",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"X\" = -10mm"
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"X\" = 10mm"
        ],
        "excludes": []
      }
    }
  }
}
