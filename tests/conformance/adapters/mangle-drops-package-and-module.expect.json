{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3.1",
  "rule": "mangling",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Part__width\""
        ],
        "excludes": [
          "acme"
        ]
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"Part__width\""
        ],
        "excludes": [
          "acme_demo__",
          "acme.demo"
        ]
      }
    }
  }
}
