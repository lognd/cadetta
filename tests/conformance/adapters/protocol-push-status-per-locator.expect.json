{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 4",
  "rule": "push-status",
  "kind": "binding",
  "entry": "protocol",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "statuses": {
      "A": "pushed",
      "B": "pushed"
    }
  },
  "must_not_fire": {
    "diagnostics": [
      {
        "code": "R008",
        "severity": "error"
      }
    ],
    "exit": 2,
    "reason": "summary-only push result"
  }
}
