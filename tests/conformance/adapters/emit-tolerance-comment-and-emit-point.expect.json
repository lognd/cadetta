{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3a",
  "rule": "emit-point-drift",
  "kind": "source",
  "entry": "emit sw-equations",
  "note": "emit writes the emit point (quantities.md 5.6), never the nominal; trailing comment names tolerance",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "12.02mm"
        ],
        "excludes": []
      }
    }
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"W\" = 12mm"
        ],
        "excludes": []
      }
    }
  }
}
