{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3.3",
  "rule": "interface-slot-for",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"A\""
        ],
        "excludes": [
          "\"B\""
        ]
      }
    },
    "active_alternate": "acme.shop::Colson2Series"
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"A\"",
          "\"B\""
        ],
        "excludes": []
      }
    },
    "active_alternate": "acme.shop::Colson2Series"
  }
}
