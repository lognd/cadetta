{
  "spec": "1.4",
  "doc": "adapters",
  "section": "adapters.md 3.2",
  "rule": "run-flags-narrow",
  "kind": "source",
  "entry": "emit sw-equations",
  "must_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [],
        "excludes": [
          "\"GW\"",
          "\"GD\""
        ]
      }
    },
    "args": [
      "--module",
      "acme.demo::gear"
    ]
  },
  "must_not_fire": {
    "diagnostics": [],
    "exit": 0,
    "output": {
      "build/eq.txt": {
        "contains": [
          "\"SW\""
        ],
        "excludes": [
          "\"GW\""
        ]
      }
    },
    "args": [
      "--module",
      "acme.demo::gear::sub"
    ]
  }
}
