// std: the cadetta standard library, package root (stdlib.md 1).
//
// Written in ordinary .cdt. Every module is a file under this directory
// (packages.md 2), added by its own story: fits, materials, fasteners,
// retaining, commercial. Per-standard `pub use` re-exports (iso273, iso286,
// din471, din472, ...) live at this root once the syntax and the
// standards' figures land. Nothing is declared here yet on purpose: no
// value may appear in std without a citation (S001).

// Per-standard citation exports (stdlib.md 1). Each re-exports the
// cite item written beside the figures it covers, so the record lives once.

/// ISO 286-1 and 286-2 limits and fits.
pub use self::fits::iso286

/// ISO 261 and ISO 724 metric thread profile and coarse pitches.
pub use self::fasteners::tables::iso724

/// ISO 273 clearance holes for bolts and screws.
pub use self::fasteners::tables::iso273

/// ISO 2306 and Machinery's Handbook tap-drill sizes.
pub use self::fasteners::tables::tapdrill

/// ISO 4762 hexagon socket head cap screws.
pub use self::fasteners::tables::iso4762

/// ISO 4032 hexagon regular nuts.
pub use self::fasteners::tables::iso4032

/// DIN 471 retaining rings for shafts.
pub use self::retaining::din471

/// DIN 472 retaining rings for bores.
pub use self::retaining::din472

/// ASME B1.1 unified inch threads.
pub use self::fasteners::inch::asme_b1_1

/// ASME B18.3 inch socket head cap screws.
pub use self::fasteners::inch::asme_b18_3

/// Machinery's Handbook inch tap drills.
pub use self::fasteners::inch::inch_tapdrill

/// Machinery's Handbook inch clearance drills.
pub use self::fasteners::inch::inch_clearance
