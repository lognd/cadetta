  MetricThread::M3 => 6.72mm, 1.86mm, 2mm, 6.72mm, 1.86mm
  MetricThread::M4 => 8.96mm, 2.48mm, 2.5mm, 8.96mm, 2.48mm
  MetricThread::M5 => 11.2mm, 3.1mm, 3mm, 11.2mm, 3.1mm
