// std::fasteners tables: metric coarse threads, ISO 273 clearance holes, tap drills,
// ISO 4762 socket head cap screw heads and lengths, ISO 7380 button heads, ISO 10642
// countersunk heads, ISO 4032 nuts (stdlib.md 1, 2).
//
// Sizes M1.6 to M20, coarse pitch only (inch is std::fasteners::inch, 0.2.0).
// An underscore between digits in a variant is the decimal mark (M1_6 is M1.6).
// Lengths and diameters are in mm as the standards print them. Limits are kept
// as published: head_height (k) and nut height (m) are the maximum with the
// published minimum as a [+0 -x] deviation; head_dia, socket, Iso273 holes,
// counterbore_dia and tap drills are nominal (stdlib.md 2).
//
// Thread: minor_ext is the external-thread minor diameter d3 = d - 1.22687 P
// and minor_int the internal-thread minor D1 = d - 1.08253 P (ISO 724 basic
// profile), computed from the exact profile constants and rounded to um.
//
// TapDrill columns: cut_75 and cut_65 are the cutting-tap drills at about 75%
// and 65% thread (Machinery's Handbook tap-drill tables, nearest ISO 2306
// preferred drill); form is the roll-tap (forming) drill of ISO 2306.
//
// PROVENANCE WARNING: figures were entered from recall of ISO 273, ISO 724,
// ISO 2306, ISO 4762, ISO 4032 and Machinery's Handbook, not transcribed from
// the standards. Least certain: counterbore_dia/counterbore_depth for M1.6,
// M2, M2.5 (ISO 4762 annex / DIN 974-1), the cut_65 and form drill columns,
// the M16 and M20 form drills, and the nut height minima. Iso7380Head and
// Iso10642Head list only the sizes their standards cover (M3 to M16 and M3 to
// M20); a counterbore on another size is E007 (no row). For ISO 7380 the
// counterbore columns are derived, not published: diameter = head_dia + 1 mm
// rounded up to 0.5 mm, depth = head_height + 0.5 mm. For ISO 10642 the
// pocket is the countersink: diameter = head_dia and depth = head_height, so
// the head sits flush. Verify both against DIN 974-2 / ISO 15065 in the audit. The std citation
// audit must verify every row before release.

/// The citation for the thread profile and coarse pitches: ISO 261 and ISO 724.
pub cite iso724: standard {
    organization = "ISO"
    number = "ISO 724:1993"
    title = "ISO general-purpose metric screw threads: basic dimensions"
    date = "1993"
    note = "With ISO 261:1998 general plan"
}

/// The citation for clearance holes: ISO 273.
pub cite iso273: standard {
    organization = "ISO"
    number = "ISO 273:1979"
    title = "Fasteners: clearance holes for bolts and screws"
    date = "1979"
}

/// The citation for tap-drill and roll-tap drill sizes: ISO 2306 and Machinery's Handbook.
pub cite tapdrill: standard {
    organization = "ISO"
    number = "ISO 2306:2015"
    title = "Drills for use prior to tapping and thread forming"
    date = "2015"
    note = "With the Machinery's Handbook tap drill tables"
}

/// The citation for socket head cap screws: ISO 4762.
pub cite iso4762: standard {
    organization = "ISO"
    number = "ISO 4762:2004"
    title = "Hexagon socket head cap screws"
    date = "2004"
    note = "Counterbore per ISO 4762 annex and DIN 974-1"
}

/// The citation for button head socket screws: ISO 7380.
pub cite iso7380: standard {
    organization = "ISO"
    number = "ISO 7380-1:2011"
    title = "Hexagon socket button head screws"
    date = "2011"
    note = "Counterbore derived from head dimensions (DIN 974-2 style)"
}

/// The citation for countersunk socket screws: ISO 10642.
pub cite iso10642: standard {
    organization = "ISO"
    number = "ISO 10642:2004"
    title = "Hexagon socket countersunk head screws"
    date = "2004"
    note = "Pocket is the countersink: head diameter by head height"
}

/// The citation for hexagon nuts: ISO 4032.
pub cite iso4032: standard {
    organization = "ISO"
    number = "ISO 4032:2012"
    title = "Hexagon regular nuts (style 1), product grades A and B"
    date = "2012"
}

/// The metric coarse thread sizes std knows (M1_6 displays as M1.6).
pub enum MetricThread { M1_6, M2, M2_5, M3, M4, M5, M6, M8, M10, M12, M16, M20 }

/// Coarse thread major, pitch and minor diameters, mm (ISO 724).
pub table Thread @iso724:"coarse series" {
  key thread: MetricThread
  cols major: Length, pitch: Length, minor_ext: Length, minor_int: Length
  MetricThread::M1_6 => 1.6mm, 0.35mm, 1.171mm, 1.221mm
  MetricThread::M2 => 2mm, 0.4mm, 1.509mm, 1.567mm
  MetricThread::M2_5 => 2.5mm, 0.45mm, 1.948mm, 2.013mm
  MetricThread::M3 => 3mm, 0.5mm, 2.387mm, 2.459mm
  MetricThread::M4 => 4mm, 0.7mm, 3.141mm, 3.242mm
  MetricThread::M5 => 5mm, 0.8mm, 4.019mm, 4.134mm
  MetricThread::M6 => 6mm, 1mm, 4.773mm, 4.917mm
  MetricThread::M8 => 8mm, 1.25mm, 6.466mm, 6.647mm
  MetricThread::M10 => 10mm, 1.5mm, 8.16mm, 8.376mm
  MetricThread::M12 => 12mm, 1.75mm, 9.853mm, 10.106mm
  MetricThread::M16 => 16mm, 2mm, 13.546mm, 13.835mm
  MetricThread::M20 => 20mm, 2.5mm, 16.933mm, 17.294mm
}

/// Fine, medium and coarse clearance hole diameters, mm (ISO 273).
pub table Iso273 @iso273:"table 1" {
  key thread: MetricThread
  cols fine: Length, medium: Length, coarse: Length
  MetricThread::M1_6 => 1.7mm, 1.8mm, 2mm
  MetricThread::M2 => 2.2mm, 2.4mm, 2.6mm
  MetricThread::M2_5 => 2.7mm, 2.9mm, 3.1mm
  MetricThread::M3 => 3.2mm, 3.4mm, 3.6mm
  MetricThread::M4 => 4.3mm, 4.5mm, 4.8mm
  MetricThread::M5 => 5.3mm, 5.5mm, 5.8mm
  MetricThread::M6 => 6.4mm, 6.6mm, 7mm
  MetricThread::M8 => 8.4mm, 9mm, 10mm
  MetricThread::M10 => 10.5mm, 11mm, 12mm
  MetricThread::M12 => 13mm, 13.5mm, 14.5mm
  MetricThread::M16 => 17mm, 17.5mm, 18.5mm
  MetricThread::M20 => 21mm, 22mm, 24mm
}

/// Tap drill diameters, cutting 75% and 65% and forming, mm (ISO 2306).
pub table TapDrill @tapdrill:"coarse threads" {
  key thread: MetricThread
  cols cut_75: Length, cut_65: Length, form: Length
  MetricThread::M1_6 => 1.25mm, 1.3mm, 1.45mm
  MetricThread::M2 => 1.6mm, 1.65mm, 1.8mm
  MetricThread::M2_5 => 2.05mm, 2.1mm, 2.3mm
  MetricThread::M3 => 2.5mm, 2.6mm, 2.8mm
  MetricThread::M4 => 3.3mm, 3.4mm, 3.7mm
  MetricThread::M5 => 4.2mm, 4.3mm, 4.65mm
  MetricThread::M6 => 5mm, 5.2mm, 5.55mm
  MetricThread::M8 => 6.8mm, 6.9mm, 7.4mm
  MetricThread::M10 => 8.5mm, 8.7mm, 9.3mm
  MetricThread::M12 => 10.2mm, 10.5mm, 11.2mm
  MetricThread::M16 => 14mm, 14.3mm, 15mm
  MetricThread::M20 => 17.5mm, 17.9mm, 18.8mm
}

/// Socket head cap screw head and counterbore dimensions, mm (ISO 4762).
pub table Iso4762Head @iso4762:"table 1; counterbore annex" {
  key thread: MetricThread
  cols head_dia: Length, head_height: Length, socket: Length, counterbore_dia: Length, counterbore_depth: Length
  MetricThread::M1_6 => 3mm, 1.6mm [+0 -0.14mm], 1.5mm, 3.7mm, 2mm
  MetricThread::M2 => 3.8mm, 2mm [+0 -0.14mm], 1.5mm, 4.5mm, 2.4mm
  MetricThread::M2_5 => 4.5mm, 2.5mm [+0 -0.14mm], 2mm, 5.5mm, 2.9mm
  MetricThread::M3 => 5.5mm, 3mm [+0 -0.14mm], 2.5mm, 6.5mm, 3.4mm
  MetricThread::M4 => 7mm, 4mm [+0 -0.18mm], 3mm, 8mm, 4.4mm
  MetricThread::M5 => 8.5mm, 5mm [+0 -0.18mm], 4mm, 9.5mm, 5.4mm
  MetricThread::M6 => 10mm, 6mm [+0 -0.3mm], 5mm, 11mm, 6.5mm
  MetricThread::M8 => 13mm, 8mm [+0 -0.36mm], 6mm, 14mm, 8.6mm
  MetricThread::M10 => 16mm, 10mm [+0 -0.36mm], 8mm, 17.5mm, 10.8mm
  MetricThread::M12 => 18mm, 12mm [+0 -0.43mm], 10mm, 20mm, 13mm
  MetricThread::M16 => 24mm, 16mm [+0 -0.43mm], 14mm, 26mm, 17.5mm
  MetricThread::M20 => 30mm, 20mm [+0 -0.52mm], 17mm, 33mm, 21.5mm
}

/// Button head screw head and counterbore dimensions, mm (ISO 7380-1); M3 to M16 only.
pub table Iso7380Head @iso7380:"table 1; derived counterbore" {
  key thread: MetricThread
  cols head_dia: Length, head_height: Length, socket: Length, counterbore_dia: Length, counterbore_depth: Length
  MetricThread::M3 => 5.7mm, 1.65mm, 2mm, 7mm, 2.2mm
  MetricThread::M4 => 7.6mm, 2.2mm, 2.5mm, 9mm, 2.7mm
  MetricThread::M5 => 9.5mm, 2.75mm, 3mm, 10.5mm, 3.3mm
  MetricThread::M6 => 10.5mm, 3.3mm, 4mm, 11.5mm, 3.8mm
  MetricThread::M8 => 14mm, 4.4mm, 5mm, 15mm, 4.9mm
  MetricThread::M10 => 17.5mm, 5.5mm, 6mm, 18.5mm, 6mm
  MetricThread::M12 => 21mm, 6.6mm, 8mm, 22mm, 7.1mm
  MetricThread::M16 => 28mm, 8.8mm, 10mm, 29mm, 9.3mm
}

