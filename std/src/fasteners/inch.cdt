// std::fasteners::inch: unified inch threads (UNC and UNF), clearance and tap
// drills, ASME B18.3 socket head cap screws (stdlib.md 1, 2).
//
// Sizes #4 to 1/2 in, coarse and fine. Lengths and diameters are in inches as
// the standards print them; limits are nominal (the published maximum for
// head_dia, nominal for head_height). minor_ext is d3 = d - 1.22687 P and
// minor_int is D1 = d - 1.08253 P (the 60 degree basic profile of ASME B1.1,
// as ISO 724), rounded to 0.0001 in. Tap drills are the numbered, lettered or
// fractional drills of Machinery's Handbook at about 75% thread; clearances
// are its close-fit and free-fit drills.
//
// PROVENANCE WARNING: figures were entered from recall of ASME B1.1, ASME
// B18.3 and Machinery's Handbook, not transcribed from the books. Least
// certain: the close/free clearance drills for #8 and 1/2 in, the 5/16 in
// socket size, and the preferred length list. The std citation audit must
// verify every row. Inch heat-set and wire-thread inserts (std::inserts) are
// not yet present: they have no single published standard to cite.

/// The citation for unified inch threads: ASME B1.1.
pub cite asme_b1_1: standard {
    organization = "ASME"
    number = "ASME B1.1-2003"
    title = "Unified inch screw threads (UN and UNR thread form)"
    date = "2003"
}

/// The citation for inch socket head cap screws: ASME B18.3.
pub cite asme_b18_3: standard {
    organization = "ASME"
    number = "ASME B18.3-2012"
    title = "Socket cap, shoulder, set screws and hex keys (inch series)"
    date = "2012"
}

/// The citation for inch tap drills: Machinery's Handbook.
pub cite inch_tapdrill: book {
    title = "Machinery's Handbook"
    publisher = "Industrial Press"
    edition = "31st"
    note = "Tap drill sizes for unified threads, 75% thread"
}

/// The citation for inch clearance drills: Machinery's Handbook.
pub cite inch_clearance: book {
    title = "Machinery's Handbook"
    publisher = "Industrial Press"
    edition = "31st"
    note = "Clearance holes for screws, close and free fit"
}

/// Inch thread sizes std knows: UNC and UNF by number or fraction (F1x4 is 1/4 in, F5x16 is 5/16 in).
pub enum InchThread { No4Unc40, No4Unf48, No6Unc32, No6Unf40, No8Unc32, No8Unf36, No10Unc24, No10Unf32, F1x4Unc20, F1x4Unf28, F5x16Unc18, F5x16Unf24, F3x8Unc16, F3x8Unf24, F1x2Unc13, F1x2Unf20 }

