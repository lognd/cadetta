// std::fasteners screwjoint: ScrewJoint, "screw here", derived members (stdlib.md 3).
//
// One line per hole pattern; every derived dimension is a member of the joint.
// The public members are exactly those of stdlib.md 3; every intermediate is
// `priv` (packages.md 3) but still evaluated and shown by why and impact.
// The shop's numbers come from the policy argument (stdlib.md 4): the
// engagement factor, which TapDrill column a tap uses, the preferred lengths,
// the drills on the shelf and the depth allowances.
//
// This file carries the arguments the derived members need (thread, clamp,
// into, policy, clearance, counterbore, tap, count). The remaining arguments
// (head, at, onto, host, depth_available, nut, locating, screw_cost, tap =
// Vendor) and the joint's checks belong to the arguments-and-checks story.
//
// Decisions: without a counterbore the pocket members are zero (no pocket,
// no depth), so `grip` is simply `clamp`. `float` is the fixed-fastener
// allowance (geometry.md 5): half the clearance over the thread major.
//
// PROVENANCE WARNING: this file adds no figures of its own; every number is
// read from tables.cdt, materials.cdt and the policy, and inherits their
// provenance warnings.

use crate::materials::{Material, Materials, TapClass}
use super::policy::{FastenerPolicy, TapColumn}
use super::screw::Iso4762
use super::tables::{Iso273, Iso4762Head, MetricThread, TapDrill, Thread}

/// ISO 273 clearance hole series: fine, medium (default) or coarse.
pub enum ClearanceClass { Fine, Medium, Coarse }

/// How the threaded hole is made: a cutting tap or a forming (roll) tap.
pub enum TapKind { Cut, Form }

/// A screw joint: clearance hole, counterbore, screw length, tap drill, depths and callout.
pub assembly ScrewJoint(
  thread: MetricThread,
  clamp: Length,
  into: Material,
  policy: FastenerPolicy,
  clearance: ClearanceClass = ClearanceClass::Medium,
  counterbore: Bool = false,
  tap: TapKind = TapKind::Cut,
  count: Count = 1
) {
  priv major = Thread[thread].major
  priv pitch = Thread[thread].pitch
  priv head = Iso4762Head[thread]
  priv column = match tap {
    TapKind::Cut => policy.tap_columns[Materials[into].tap_class].cut,
    TapKind::Form => policy.tap_columns[Materials[into].tap_class].form,
  }
  priv drill_nominal = match column {
    TapColumn::Cut75 => TapDrill[thread].cut_75,
    TapColumn::Cut65 => TapDrill[thread].cut_65,
    TapColumn::Form => TapDrill[thread].form,
  }

  /// Clearance hole diameter from ISO 273 at the joint's clearance class.
  clearance_hole = match clearance {
    ClearanceClass::Fine => Iso273[thread].fine,
    ClearanceClass::Medium => Iso273[thread].medium,
    ClearanceClass::Coarse => Iso273[thread].coarse,
  }
  /// Counterbore diameter from ISO 4762 (zero without a counterbore).
  counterbore_dia = if counterbore { head.counterbore_dia } else { 0mm }
  /// Counterbore depth from ISO 4762 (zero without a counterbore).
  counterbore_depth = if counterbore { head.counterbore_depth } else { 0mm }
  /// Least thread engagement: the policy factor for the host material times the thread major.
  min_engagement = policy.engagement[into].factor * major
  /// Material under the head: clamp less any counterbore depth.
  grip = clamp - counterbore_depth
  /// Shortest preferred screw length that reaches grip plus minimum engagement.
  screw_length = policy.lengths.at_least(grip + min_engagement).key
  /// The joint's screws, one per hole, so roll-ups count every screw.
  part screw[count]: Iso4762(thread, screw_length)
  /// Allowance for a screw in its clearance hole: half the clearance over the thread major.
  float = (clearance_hole - major) / 2
  /// Tap drill: the policy's column for the host material, rounded up to a drill on the shelf.
  tap_drill = policy.drills.at_least(drill_nominal).key
  /// Threaded depth: tip penetration past the grip plus the policy's bottom clearance.
  thread_depth = screw_length - grip + policy.bottom_clearance
  /// Drilled depth: thread depth plus the tap lead-in and the drill point.
  drill_depth = thread_depth + policy.tap_lead_in * pitch + policy.drill_point * tap_drill
  /// Drawing callout for the threaded hole.
  callout = fmt("{} - 6H, {} DP; drill {} DP {}", thread, thread_depth, tap_drill, drill_depth)
}
