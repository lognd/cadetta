// std::fasteners screwjoint: ScrewJoint, "screw here", derived members (stdlib.md 3).
//
// One line per hole pattern; every derived dimension is a member of the joint.
// The public members are exactly those of stdlib.md 3; every intermediate is
// `priv` (packages.md 3) but still evaluated and shown by why and impact.
// The shop's numbers come from the policy argument (stdlib.md 4): the
// engagement factor, which TapDrill column a tap uses, the preferred lengths,
// the drills on the shelf and the depth allowances.
//
// Arguments (stdlib.md 3): thread, clamp, policy, head, clearance,
// counterbore, tap (Cut, Form or Vendor), count, and the optional ones
// into, host, depth_available, screw_cost, at and onto (`name?: Type`,
// language.md 3.3: omitted means absent, tested with `given(name)`), plus the
// flags `nut` (onto is a second clearance pattern) and `locating`
// (stdlib.md 3; the placement float of `locating` is geometry.md 5.2).
//
// Presence rules are written as `#[when(cond)]` on a member or check: it
// exists only while cond holds. `into` defaults to `host.material`. Under
// `tap = Vendor` the tap drill members are absent and `depth_available` is
// required (`#![requires(...)]`, E006 when missing). A joint is one part per
// pattern: `count` with `at` is E006 (`#![forbids(...)]`), and the count of a
// patterned joint is `count(at)` (`n`), never a `part j[N]` array. The checks are the
// named verdicts of stdlib.md 3 (`Mount/screws.engaged`).
//
// The pocket comes from the head's table (Iso4762Head, Iso7380Head, Iso10642Head);
// a size a head standard does not cover is E007 only when counterbore = true.
//
// Decisions: without a counterbore the pocket members are zero (no pocket,
// no depth), so `grip` is simply `clamp`. `float` is the allowance
// `aligned(at, onto, float)` uses (geometry.md 5): one clearance hole's half,
// `(clearance_hole - major) / 2`, from the ISO 273 class nominal and never the
// user's hole tolerance; with `nut` both halves count.
//
// PROVENANCE WARNING: this file adds no figures of its own; every number is
// read from tables.cdt, materials.cdt and the policy, and inherits their
// provenance warnings.

use package::materials::{Material, Materials, TapClass}
use super::policy::{FastenerPolicy, TapColumn}
use super::screw::Iso4762
use super::tables::{Iso10642Head, Iso273, Iso4762Head, Iso7380Head, MetricThread, TapDrill, Thread}

/// ISO 273 clearance hole series: fine, medium (default) or coarse.
pub enum ClearanceClass { Fine, Medium, Coarse }

/// The screw head: socket (ISO 4762, default), button (ISO 7380) or flat (ISO 10642).
pub enum HeadKind { SocketHead, ButtonHead, FlatHead }

/// How the threaded hole is made: a cutting tap, a forming tap, or a hole that already exists.
pub enum TapKind { Cut, Form, Vendor }

/// A screw joint: clearance hole, counterbore, screw length, tap drill, depths and callout.
pub assembly ScrewJoint(
  thread: MetricThread,
  clamp: Length,
  policy: FastenerPolicy,
  into?: Material,
  host?: Part,
  head: HeadKind = HeadKind::SocketHead,
  clearance: ClearanceClass = ClearanceClass::Medium,
  counterbore: Bool = false,
  tap: TapKind = TapKind::Cut,
  count?: Count,
  depth_available?: Length,
  screw_cost?: Money,
  at?: Pattern2,
  onto?: Pattern2,
  nut: Bool = false,
  locating: Bool = false
) {
  #![requires(depth_available, when = tap == TapKind::Vendor)]
  #![forbids(count, when = given(at))]
  priv material = if given(into) { into } else { host.material }
  priv major = Thread[thread].major
  priv pitch = Thread[thread].pitch
  #[when(counterbore)]
  priv pocket_dia = match head {
    HeadKind::SocketHead => Iso4762Head[thread].counterbore_dia,
    HeadKind::ButtonHead => Iso7380Head[thread].counterbore_dia,
    HeadKind::FlatHead => Iso10642Head[thread].counterbore_dia,
  }
  #[when(counterbore)]
  priv pocket_depth = match head {
    HeadKind::SocketHead => Iso4762Head[thread].counterbore_depth,
    HeadKind::ButtonHead => Iso7380Head[thread].counterbore_depth,
    HeadKind::FlatHead => Iso10642Head[thread].counterbore_depth,
  }
  #[when(tap != TapKind::Vendor)]
  priv column = match tap {
    TapKind::Cut => policy.tap_columns[Materials[material].tap_class].cut,
    TapKind::Form => policy.tap_columns[Materials[material].tap_class].form,
    TapKind::Vendor => policy.tap_columns[Materials[material].tap_class].cut,
  }
  #[when(tap != TapKind::Vendor)]
  priv drill_nominal = match column {
    TapColumn::Cut75 => TapDrill[thread].cut_75,
    TapColumn::Cut65 => TapDrill[thread].cut_65,
    TapColumn::Form => TapDrill[thread].form,
  }

  /// Clearance hole diameter from ISO 273 at the joint's clearance class.
  clearance_hole = match clearance {
    ClearanceClass::Fine => Iso273[thread].fine,
    ClearanceClass::Medium => Iso273[thread].medium,
    ClearanceClass::Coarse => Iso273[thread].coarse,
  }
  /// Counterbore diameter for the head's table (zero without a counterbore; E007 if the size has no row).
  counterbore_dia = if counterbore { pocket_dia } else { 0mm }
  /// Counterbore depth for the head's table (zero without a counterbore; E007 if the size has no row).
  counterbore_depth = if counterbore { pocket_depth } else { 0mm }
  /// Least thread engagement: the policy factor for the host material times the thread major.
  min_engagement = policy.engagement[material].factor * major
  /// Material under the head: clamp less any counterbore depth.
  grip = clamp - counterbore_depth
  /// Shortest preferred screw length that reaches grip plus minimum engagement.
  screw_length = policy.lengths.at_least(grip + min_engagement).key
  /// Screws in the joint: one per hole of the pattern, else the count argument, else one.
  priv n = if given(at) { count(at) } else if given(count) { count } else { 1 }
  /// The joint's screws, one per hole, so roll-ups count every screw; priced by screw_cost.
  part screw[n]: Iso4762(thread, screw_length, screw_cost)
  /// One clearance hole's half: (clearance_hole - major) / 2, independent of any hole tolerance.
  priv half = (clearance_hole - major) / 2
  /// Allowance the aligned check uses: one half fixed, both halves (two clearance patterns) with a nut.
  float = if nut { half + half } else { half }
  /// Tap drill: the policy's column for the host material, rounded up to a drill on the shelf (absent under Vendor).
  #[when(tap != TapKind::Vendor)]
  tap_drill = policy.drills.at_least(drill_nominal).key
  /// Threaded depth: tip penetration past the grip plus the policy's bottom clearance.
  thread_depth = screw_length - grip + policy.bottom_clearance
  /// Drilled depth: thread depth plus the tap lead-in and the drill point (absent under Vendor).
  #[when(tap != TapKind::Vendor)]
  drill_depth = thread_depth + policy.tap_lead_in * pitch + policy.drill_point * tap_drill
  /// Drawing callout for the threaded hole.
  callout = if tap == TapKind::Vendor {
    fmt("{} - 6H, {} DP", thread, thread_depth)
  } else {
    fmt("{} - 6H, {} DP; drill {} DP {}", thread, thread_depth, tap_drill, drill_depth)
  }

  /// Thread engagement actually reached: the screw tip's penetration past the grip.
  priv engagement = screw_length - grip
  /// Depth the hole must offer: the thread depth for a vendor hole, else the drill depth.
  #[when(given(depth_available))]
  priv depth_needed = if tap == TapKind::Vendor { thread_depth } else { drill_depth }

  check engaged: engagement >= min_engagement "thread engagement reaches the minimum"
  check not_bottomed: thread_depth > screw_length - grip "the screw tip must not bottom out in the hole"
  check grip_positive: grip > 0mm "the counterbore must leave material under the head"
  #[when(given(depth_available))]
  check depth_ok: depth_needed <= depth_available "the hole must be deep enough"
  #[when(given(at) and given(onto))]
  check aligned: aligned(at, onto, float) "clearance holes line up with the threaded holes"
}
